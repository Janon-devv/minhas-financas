@page "/metas"
@inject PlanejamentoService Servico
@inject IRelogio Relogio

<PageTitle>Metas | Minhas Finanças</PageTitle>

<Cabecalho Titulo="Metas" Voltar="">
    <Acoes>
        @if (_dados is not null && _resumos.Count > 0)
        {
            <button type="button" class="btn sobre-escuro pequeno" @onclick="() => Abrir(null)">
                <Icone Nome="mais" Tamanho="18" /> Nova
            </button>
        }
    </Acoes>
</Cabecalho>

@if (_dados is null)
{
    <Carregando />
}
else
{
    <Grupo>
        <div class="corpo destaque-claro">
            <Rotulo Texto="Guardado até hoje"
                    Ajuda="O que você já tinha guardado mais as economias que já passaram da data. Não precisa bater com a soma das metas: uma meta pode ter começado depois." />
            <Valor Centavos="_guardadoTotal" Classe="valor-grande" />
        </div>
    </Grupo>

    @if (_resumos.Count == 0)
    {
        <Vazio Texto="Nenhuma meta cadastrada." NomeIcone="meta">
            <button type="button" class="btn" @onclick="() => Abrir(null)">Adicionar</button>
        </Vazio>
    }
    else
    {
        <Grupo SemSuperficie="true">
            <div class="colunas">
                @foreach (var meta in _resumos)
                {
                    var cheia = meta.Progresso >= 1;

                    <article class="cartao-meta" style="margin-bottom:12px" aria-labelledby="meta-@meta.Id">
                        <div class="cartao-topo">
                            <div style="min-width:0">
                                <h3 id="meta-@meta.Id">@meta.Nome</h3>
                                <p class="dica" style="margin-top:2px">
                                    @(meta.Prazo is DateOnly prazo ? $"até {Formato.Data(prazo)}" : "sem prazo")
                                </p>
                            </div>
                            <span class="pilula @(meta.Situacao == SituacaoMeta.Concluida ? "entrada"
                                                  : meta.Situacao == SituacaoMeta.PrazoVencido ? "saida" : "neutra")">
                                @Formato.TextoSituacaoMeta(meta.Situacao)
                            </span>
                        </div>

                        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:8px; margin-top:12px">
                            <span>
                                <Valor Centavos="meta.GuardadoCentavos" Classe="valor-grande" />
                            </span>
                            <span class="dica" style="margin:0; white-space:nowrap">de @Formato.Moeda(meta.ObjetivoCentavos)</span>
                        </div>
                        <div class="barra @(cheia ? "cheia" : "")" style="margin-top:8px" role="progressbar"
                             aria-valuenow="@Math.Round(Math.Min(100m, meta.Progresso * 100))" aria-valuemin="0" aria-valuemax="100"
                             aria-label="Progresso de @meta.Nome">
                            <span style="width:@(Math.Min(100m, meta.Progresso * 100).ToString("N1", CultureInfo.InvariantCulture))%"></span>
                        </div>
                        <p class="dica">@Formato.Porcento(meta.Progresso) do objetivo</p>

                        @if (meta.Situacao != SituacaoMeta.Concluida)
                        {
                            <dl class="linhas" style="margin-top:8px">
                                <div class="linha">
                                    <dt>Falta</dt>
                                    <dd><Valor Centavos="meta.FaltaCentavos" /></dd>
                                </div>
                                <div class="linha">
                                    <dt>
                                        Guardar por mês
                                        <span class="linha-sub">por @Formato.Quantos(meta.MesesRestantes, "mês", "meses")</span>
                                    </dt>
                                    <dd><Valor Centavos="meta.AporteMensalSugeridoCentavos" /></dd>
                                </div>
                                @if (meta.Prazo is not null)
                                {
                                    <div class="linha">
                                        <dt>
                                            No prazo
                                            <span class="linha-sub">com as economias já lançadas</span>
                                        </dt>
                                        <dd class="@(meta.PlanoInsuficiente ? "valor-atencao" : "")">
                                            <Valor Centavos="meta.ProjetadoNoPrazoCentavos" />
                                        </dd>
                                    </div>
                                }
                            </dl>

                            @if (meta.PlanoInsuficiente)
                            {
                                <div style="margin-top:8px">
                                    <Aviso Tipo="atencao">
                                        As economias lançadas não chegam ao objetivo no prazo.
                                        Faltam @Formato.Moeda(meta.ObjetivoCentavos - meta.ProjetadoNoPrazoCentavos).
                                    </Aviso>
                                </div>
                            }
                        }

                        <div class="acoes">
                            <a class="btn secundario pequeno" href="lancamentos?novo=1&tipo=Economia&meta=@meta.Id">
                                <Icone Nome="mais" Tamanho="16" /> Lançar economia
                            </a>
                            <button type="button" class="btn contorno pequeno" @onclick="() => AbrirPorId(meta.Id)">
                                Editar
                            </button>
                        </div>
                    </article>
                }
            </div>
        </Grupo>

        <p class="dica">Só conta como guardado o que já passou da data. O que está no futuro é plano.</p>
    }

    @if (_arquivadas.Count > 0)
    {
        <Grupo>
            <details class="detalhes">
                <summary>
                    Arquivadas (@_arquivadas.Count)
                    <Icone Nome="abrir" Tamanho="18" />
                </summary>
                <ul class="lista">
                    @foreach (var meta in _arquivadas)
                    {
                        <li>
                            <div class="item">
                                <span class="item-principal">
                                    <span class="item-titulo">@meta.Nome</span>
                                    <span class="item-sub">Objetivo de @Formato.Moeda(meta.ObjetivoCentavos)</span>
                                </span>
                                <button type="button" class="btn secundario pequeno" @onclick="() => Arquivar(meta.Id, false)">
                                    Reativar
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            </details>
        </Grupo>
    }
}

@if (_editando is not null)
{
    <Modal Titulo="@(_editando.Id == 0 ? "Nova meta" : "Editar meta")" AoFechar="Fechar">
        <ChildContent>
            <div class="campo-grupo">
                <Rotulo Texto="Nome" Para="nome" />
                <input id="nome" class="campo" @bind="_editando.Nome" autocomplete="off" placeholder="Reserva de emergência" />
            </div>

            <div class="linha-campos">
                <div class="campo-grupo">
                    <Rotulo Texto="Objetivo" Para="objetivo" />
                    <CampoDinheiro Valor="_editando.ObjetivoCentavos" ValorChanged="v => _editando.ObjetivoCentavos = v" Id="objetivo" />
                </div>
                <div class="campo-grupo">
                    <Rotulo Texto="Prazo (opcional)" Para="prazo" />
                    <CampoData Valor="_editando.Prazo" ValorChanged="v => _editando.Prazo = v" Id="prazo" />
                </div>
            </div>

            <div class="campo-grupo">
                <Rotulo Texto="Já guardado para ela" Para="inicial"
                        Ajuda="O que já estava separado para esta meta antes do saldo inicial do app." />
                <CampoDinheiro Valor="_editando.SaldoInicialCentavos" ValorChanged="v => _editando.SaldoInicialCentavos = v" Id="inicial" />
            </div>

            @if (_erros.Count > 0)
            {
                <Aviso Tipo="ruim" Papel="alert">
                    @foreach (var erro in _erros)
                    {
                        <div>@erro</div>
                    }
                </Aviso>
            }
        </ChildContent>
        <Rodape>
            <button type="button" class="btn" @onclick="SalvarAsync" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
            @if (_editando.Id != 0)
            {
                <button type="button" class="btn perigo" @onclick="() => Arquivar(_editando.Id, true)">
                    Arquivar
                </button>
            }
        </Rodape>
    </Modal>
}

@code {
    private DadosPlanejamento? _dados;
    private List<ResumoMeta> _resumos = [];
    private List<Meta> _arquivadas = [];
    private Meta? _editando;
    private List<string> _erros = [];
    private long _guardadoTotal;
    private bool _salvando;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _dados = await Servico.CarregarAsync();
        _resumos = await Servico.ObterMetasAsync();
        _arquivadas = _dados.Metas.Where(m => m.ArquivadaEm is not null).ToList();

        var projecao = Servico.Projetar(_dados, null, Relogio.Hoje);
        _guardadoTotal = projecao.Agora.GuardadoAteHojeCentavos;
    }

    private void Abrir(Meta? original)
    {
        _erros = [];

        _editando = original is null
            ? new Meta { Nome = "", ObjetivoCentavos = 0 }
            : new Meta
            {
                Id = original.Id,
                Nome = original.Nome,
                ObjetivoCentavos = original.ObjetivoCentavos,
                Prazo = original.Prazo,
                SaldoInicialCentavos = original.SaldoInicialCentavos,
                ArquivadaEm = original.ArquivadaEm
            };
    }

    private void AbrirPorId(int id) => Abrir(_dados?.Metas.FirstOrDefault(m => m.Id == id));

    private void Fechar()
    {
        _editando = null;
        _erros = [];
    }

    private async Task SalvarAsync()
    {
        // A trava vem antes de tudo: o disabled do botao chega ao celular so depois de uma ida e
        // volta pela rede, e um toque duplo rapido criaria a mesma meta duas vezes.
        if (_editando is null || _salvando)
        {
            return;
        }

        _erros = Validacao.Meta(_editando);

        if (_erros.Count > 0)
        {
            return;
        }

        _salvando = true;

        try
        {
            if (await Servico.SalvarMetaAsync(_editando) is string recusa)
            {
                _erros = [recusa];
                return;
            }

            Fechar();
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task Arquivar(int id, bool arquivar)
    {
        if (_salvando)
        {
            return;
        }

        _salvando = true;

        try
        {
            await Servico.ArquivarMetaAsync(id, arquivar);
            Fechar();
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }
}
