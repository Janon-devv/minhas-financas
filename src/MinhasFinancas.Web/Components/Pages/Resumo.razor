@page "/resumo"
@inject PlanejamentoService Servico
@inject IRelogio Relogio
@inject IJSRuntime JS

<PageTitle>Resumo | Minhas Finanças</PageTitle>

@if (_dados is null || _projecao is null)
{
    <Cabecalho Titulo="Resumo" />
    <Carregando />
}
else
{
    var conforto = _dados.Configuracao.SaldoConfortoCentavos;
    var mes = _projecao.Mes(_mes.Year, _mes.Month);

    <Cabecalho Titulo="Resumo">
        <SeletorMes Mes="_mes" PodeVoltar="PodeVoltar" PodeAvancar="PodeAvancar" AoMover="Mover" />
    </Cabecalho>

    @if (mes is null)
    {
        <Vazio Texto="Este mês está fora da previsão." />
    }
    else
    {
        var totalSaidas = mes.SaidasCentavos + mes.CartaoCentavos + mes.DiarioCentavos + mes.EconomiasCentavos;
        var maiorLado = Math.Max(1, Math.Max(mes.EntradasCentavos, totalSaidas));

        @* ---------- Entrou contra saiu ---------- *@
        <Grupo Id="resumo-mes" Classe="sem-titulo">
            @* No PC o resultado fica à esquerda e as barras à direita, alinhados com as colunas de baixo. *@
            <div class="corpo resultado-mes">
                <div>
                    <Rotulo Texto="Resultado do mês"
                            Ajuda="Entradas menos tudo que saiu no mês: contas, cartão, diário e o que foi guardado." />
                    <Valor Centavos="mes.PerformanceCentavos" Mais="true"
                           Classe="@($"valor-grande {(mes.PerformanceCentavos < 0 ? "valor-negativo" : "valor-entrada")}")" />
                </div>

                <div class="resultado-mes-barras">
                    <div class="proporcao">
                        <div class="proporcao-topo">
                            <span class="proporcao-nome">Entradas</span>
                            <span class="proporcao-valor"><Valor Centavos="mes.EntradasCentavos" /></span>
                        </div>
                        <div class="barra entrada" aria-hidden="true"><span style="width:@Largura(mes.EntradasCentavos, maiorLado)"></span></div>
                        @if (mes.GanhoVariavelCentavos > 0)
                        {
                            @* A composição, e não só o total: o resto das entradas é previsão e esta
                               parte é número digitado. *@
                            <p class="dica">Inclui @Formato.Moeda(mes.GanhoVariavelCentavos) de renda variável.</p>
                        }
                    </div>
                    <div class="proporcao">
                        <div class="proporcao-topo">
                            <span class="proporcao-nome">Saídas</span>
                            <span class="proporcao-valor"><Valor Centavos="totalSaidas" /></span>
                        </div>
                        <div class="barra saida" aria-hidden="true"><span style="width:@Largura(totalSaidas, maiorLado)"></span></div>
                    </div>
                </div>
            </div>
        </Grupo>

        <div class="colunas">
            <div>
                @* ---------- Para onde foi ---------- *@
                <Grupo Titulo="Para onde foi">
                    <div class="corpo">
                        @foreach (var (nome, valor, detalhe) in Composicao(mes))
                        {
                            <div class="proporcao">
                                <div class="proporcao-topo">
                                    <span class="proporcao-nome">@nome</span>
                                    <span class="proporcao-valor">
                                        <Valor Centavos="valor" /><small>@Formato.Porcento(totalSaidas == 0 ? 0 : (decimal)valor / totalSaidas)</small>
                                    </span>
                                </div>
                                <div class="barra" aria-hidden="true"><span style="width:@Largura(valor, Math.Max(1, totalSaidas))"></span></div>
                                @if (detalhe is not null)
                                {
                                    <p class="dica">@detalhe</p>
                                }
                            </div>
                        }

                        <dl class="linhas" style="margin-top:16px">
                            <div class="linha">
                                <dt><Rotulo Texto="Custo de vida" Classe="rotulo-dica" Ajuda="Contas, cartão e diário. O que foi guardado não entra." /></dt>
                                <dd><Valor Centavos="mes.CustoDeVidaCentavos" /></dd>
                            </div>
                            <div class="linha">
                                <dt><Rotulo Texto="Economizado" Classe="rotulo-dica" Ajuda="O que foi guardado dividido pelas entradas do mês." /></dt>
                                <dd>@Formato.Porcento(mes.EconomizadoFracao)</dd>
                            </div>
                            @if (mes.EntradasIncertasForaCentavos > 0)
                            {
                                <div class="linha">
                                    <dt><Rotulo Texto="Entradas incertas" Classe="rotulo-dica" Ajuda="Entradas marcadas como incertas neste mês. Ficaram fora do saldo previsto e das entradas acima." /></dt>
                                    <dd><Valor Centavos="mes.EntradasIncertasForaCentavos" /></dd>
                                </div>
                            }
                        </dl>
                    </div>
                </Grupo>

                @* ---------- Por tag ---------- *@
                <Grupo Titulo="Por tag">
                    <div class="corpo">
                        @if (mes.SaidasPorTag.Count == 0)
                        {
                            <p class="dica" style="margin:0">Nenhuma saída com tag neste mês.</p>
                        }
                        else
                        {
                            @foreach (var tag in mes.SaidasPorTag)
                            {
                                var classe = Formato.ClasseTag(
                                    tag.TagId is int id ? _dados.Tags.FirstOrDefault(t => t.Id == id)?.Cor : null);

                                <div class="proporcao">
                                    <div class="proporcao-topo">
                                        <span class="pilula @classe">@tag.Nome</span>
                                        <span class="proporcao-valor">
                                            <Valor Centavos="tag.ValorCentavos" /><small>@Formato.Porcento(tag.Fracao)</small>
                                        </span>
                                    </div>
                                    <div class="barra" aria-hidden="true">
                                        <span class="@classe" style="width:@((tag.Fracao * 100).ToString("N1", CultureInfo.InvariantCulture))%"></span>
                                    </div>
                                </div>
                            }
                            <p class="dica" style="margin-top:12px">Saídas, cartão e economias. O diário não tem tag.</p>
                        }
                    </div>
                </Grupo>
            </div>

            <div>
                @* ---------- Saldo do mês ---------- *@
                <Grupo Titulo="Saldo">
                    <div class="corpo">
                        <dl class="indicadores" style="grid-template-columns:1fr 1fr">
                            <div>
                                <dt>No fim do mês</dt>
                                <dd>
                                    <Valor Centavos="mes.SaldoFimCentavos" Classe="@Formato.ClasseValor(mes.SaldoFimCentavos ?? 0, conforto)" />
                                    <span class="indicador-sub">@Formato.Data(mes.UltimoDia)</span>
                                </dd>
                            </div>
                            <div>
                                <dt>Menor saldo</dt>
                                <dd>
                                    <Valor Centavos="mes.MenorSaldoCentavos" Classe="@Formato.ClasseValor(mes.MenorSaldoCentavos ?? 0, conforto)" />
                                    @if (mes.DataMenorSaldo is DateOnly dataMenor)
                                    {
                                        <span class="indicador-sub">@Formato.Data(dataMenor)</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                        <div style="margin:12px 0 16px"><FarolTag Farol="mes.Farol" /></div>
                        <GraficoSaldo Serie="SerieDoMes()" Conforto="conforto" />
                    </div>
                </Grupo>
            </div>
        </div>
    }

    @* ---------- Próximos 12 meses ---------- *@
    <Grupo Titulo="Próximos 12 meses">
        <ul class="lista so-celular">
            @foreach (var linha in _projecao.Meses.Take(12))
            {
                var atual = linha.Ano == _mes.Year && linha.Mes == _mes.Month;

                <li>
                    <button type="button" class="item" @onclick="() => Selecionar(linha.Ano, linha.Mes)"
                            aria-current="@(atual ? "true" : null)"
                            style="@(atual ? "background:var(--acento-suave)" : null)">
                        <span class="item-principal">
                            <span class="item-titulo">@Formato.MesAno(linha.Ano, linha.Mes)</span>
                            <span class="item-sub">
                                Resultado <Valor Centavos="linha.PerformanceCentavos" Mais="true" Classe="@(linha.PerformanceCentavos < 0 ? "valor-negativo" : null)" />
                            </span>
                        </span>
                        <span class="item-valor">
                            <Valor Centavos="linha.SaldoFimCentavos" />
                            <span class="item-valor-sub">
                                menor <Valor Centavos="linha.MenorSaldoCentavos" Classe="@Formato.ClasseValor(linha.MenorSaldoCentavos ?? 0, conforto)" />
                            </span>
                        </span>
                    </button>
                </li>
            }
        </ul>

        <div class="rolagem so-desktop">
            <table class="tabela">
                <thead>
                    <tr>
                        <th scope="col">Mês</th>
                        <th scope="col" class="num">Entradas</th>
                        <th scope="col" class="num">Contas, cartão e diário</th>
                        <th scope="col" class="num">Guardado</th>
                        <th scope="col" class="num">Resultado</th>
                        <th scope="col" class="num">Saldo no fim</th>
                        <th scope="col" class="num">Menor saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linha in _projecao.Meses.Take(12))
                    {
                        var atual = linha.Ano == _mes.Year && linha.Mes == _mes.Month;

                        <tr class="@(atual ? "selecionado" : "")">
                            <td>
                                <button type="button" class="btn texto pequeno" style="padding:0"
                                        aria-current="@(atual ? "true" : null)"
                                        @onclick="() => Selecionar(linha.Ano, linha.Mes)">
                                    @Formato.MesAno(linha.Ano, linha.Mes)
                                </button>
                            </td>
                            <td class="num"><Valor Centavos="linha.EntradasCentavos" /></td>
                            <td class="num"><Valor Centavos="linha.SaidasECartaoCentavos + linha.DiarioCentavos" /></td>
                            <td class="num"><Valor Centavos="linha.EconomiasCentavos" /></td>
                            <td class="num"><Valor Centavos="linha.PerformanceCentavos" Classe="@(linha.PerformanceCentavos < 0 ? "valor-negativo" : null)" /></td>
                            <td class="num"><Valor Centavos="linha.SaldoFimCentavos" /></td>
                            <td class="num"><Valor Centavos="linha.MenorSaldoCentavos" Classe="@Formato.ClasseValor(linha.MenorSaldoCentavos ?? 0, conforto)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Grupo>
}

@code {
    private DadosPlanejamento? _dados;
    private ResultadoProjecao? _projecao;
    private DateOnly _mes;
    private bool _rolarParaTopo;

    private bool PodeVoltar => _projecao is not null && _mes > MinhasFinancas.Domain.Calendario.PrimeiroDiaDoMes(_projecao.Inicio);

    private bool PodeAvancar => _projecao is not null && _mes < MinhasFinancas.Domain.Calendario.PrimeiroDiaDoMes(_projecao.Fim);

    protected override async Task OnInitializedAsync()
    {
        _dados = await Servico.CarregarAsync();
        _projecao = Servico.Projetar(_dados, null, Relogio.Hoje);
        _mes = MinhasFinancas.Domain.Calendario.PrimeiroDiaDoMes(
            MinhasFinancas.Domain.Calendario.Maior(Relogio.Hoje, _projecao.Inicio));
    }

    protected override async Task OnAfterRenderAsync(bool primeiraRenderizacao)
    {
        if (_rolarParaTopo)
        {
            _rolarParaTopo = false;
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private void Mover(int meses) => _mes = _mes.AddMonths(meses);

    /// <summary>Abre o mês tocado na lista e volta ao topo, onde estão os números dele.</summary>
    private void Selecionar(int ano, int mes)
    {
        _mes = new DateOnly(ano, mes, 1);
        _rolarParaTopo = true;
    }

    /// <summary>As quatro saídas do mês, na ordem em que costumam pesar.</summary>
    private static IEnumerable<(string Nome, long Valor, string? Detalhe)> Composicao(ResumoMes mes)
    {
        yield return ("Contas", mes.SaidasCentavos, null);
        yield return ("Cartão", mes.CartaoCentavos, null);
        yield return ("Diário", mes.DiarioCentavos,
            mes.DiarioMedioCentavos is long media
                ? $"Média de {Formato.Moeda(media)} por dia vivido, {Formato.Quantos(mes.DiasComDiarioReal, "dia registrado", "dias registrados")}."
                : null);
        yield return ("Guardado", mes.EconomiasCentavos, null);
    }

    private static string Largura(long valor, long total) =>
        (Math.Clamp((double)valor / total, 0, 1) * 100).ToString("N1", CultureInfo.InvariantCulture) + "%";

    private List<PontoGrafico> SerieDoMes() =>
        (_projecao?.Dias ?? [])
        .Where(dia => dia.Data.Year == _mes.Year && dia.Data.Month == _mes.Month)
        .Select(dia => new PontoGrafico(dia.Data, dia.SaldoCentavos))
        .ToList();
}
