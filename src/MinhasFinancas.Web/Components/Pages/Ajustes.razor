@page "/ajustes"
@inject PlanejamentoService Servico
@inject BackupService Backup
@inject IRelogio Relogio
@inject InfoApp Info

<PageTitle>Ajustes | Minhas Finanças</PageTitle>

<Cabecalho Titulo="Ajustes" />

@if (_cfg is null || _dados is null)
{
    <Carregando />
}
else
{
    @* No PC: conferência e parâmetros de um lado, cadastros e backup do outro. *@
    <div class="colunas">
        <div>
            @* ---------- Conferir saldo ---------- *@
            <Grupo Titulo="Conferir saldo" Id="conferir">
                <div class="corpo">
                    @if (_saldoProjetadoHoje is long projetado)
                    {
                        var diferenca = _saldoReal - projetado;

                        <dl class="linhas">
                            <div class="linha">
                                <dt>Previsto para o fim de hoje</dt>
                                <dd><Valor Centavos="projetado" /></dd>
                            </div>
                        </dl>

                        <div class="campo-grupo" style="margin-top:12px">
                            <Rotulo Texto="Saldo no banco agora" Para="saldo-real"
                                    Ajuda="O saldo que o app do banco mostra agora, já com os gastos de hoje. Se ainda vai sair algo hoje que o banco não mostra, confira amanhã." />
                            <CampoDinheiro Valor="_saldoReal" ValorChanged="v => _saldoReal = v" Id="saldo-real" />
                        </div>

                        @if (diferenca == 0)
                        {
                            <Aviso Tipo="bom">Bateu com a previsão.</Aviso>
                        }
                        else
                        {
                            <Aviso Tipo="atencao">
                                <strong>Diferença de @Formato.Moeda(diferenca).</strong>
                                @(diferenca < 0
                                    ? "Você tem menos que o previsto: talvez falte registrar um gasto."
                                    : "Você tem mais que o previsto: talvez uma entrada veio antes ou o gasto foi menor.")
                            </Aviso>
                            <div class="acoes">
                                <button type="button" class="btn" @onclick="Recalibrar" disabled="@_salvandoConferencia">
                                    Atualizar saldo para @Formato.Moeda(_saldoReal)
                                </button>
                            </div>
                            <p class="dica">Vale a partir de amanhã, porque o banco já inclui o que saiu hoje. Nada é apagado.</p>
                        }
                    }
                    else
                    {
                        <p class="dica" style="margin:0">
                            A previsão começa em @Formato.Data(_cfg.DataAncora). A conferência abre a partir desse dia.
                        </p>
                    }

                    @if (_mensagemConferencia is not null)
                    {
                        <div style="margin-top:12px">
                            <Aviso Tipo="bom" Papel="status">@_mensagemConferencia</Aviso>
                        </div>
                    }
                </div>
            </Grupo>

            @* ---------- Saldo e previsão ---------- *@
            <Grupo Titulo="Saldo e previsão">
                <div class="corpo">
                    <div class="linha-campos">
                        <div class="campo-grupo">
                            <Rotulo Texto="Saldo inicial" Para="saldo-ancora"
                                    Ajuda="O saldo da conta no início do dia ao lado, antes dos gastos desse dia. A previsão começa dele. Pode ser negativo." />
                            <CampoDinheiro Valor="_cfg.SaldoAncoraCentavos" ValorChanged="v => _cfg.SaldoAncoraCentavos = v" Id="saldo-ancora" />
                        </div>
                        <div class="campo-grupo">
                            <Rotulo Texto="No início de" Para="data-ancora" />
                            <CampoData Valor="_cfg.DataAncora" ValorChanged="v => _cfg.DataAncora = v ?? Relogio.Hoje" Id="data-ancora" />
                        </div>
                    </div>

                    <div class="campo-grupo">
                        <Rotulo Texto="Diário previsto" Para="diario-previsto"
                                Ajuda="Quanto você costuma gastar por dia em miudezas. Na dúvida, erre para mais." />
                        <CampoDinheiro Valor="_cfg.DiarioPrevistoCentavos" ValorChanged="v => _cfg.DiarioPrevistoCentavos = v" Id="diario-previsto" />
                        <label class="interruptor" style="margin-top:8px">
                            Descontar todo dia
                            <input type="checkbox" role="switch" @bind="_cfg.DiarioPrevistoAtivo" />
                        </label>
                        <div class="dica">
                            @(_cfg.DiarioPrevistoAtivo
                                ? "Dia sem registro conta o previsto, inclusive os que já passaram."
                                : "Dia sem registro conta zero. O valor fica guardado só como referência.")
                        </div>
                    </div>

                    <div class="linha-campos">
                        <div class="campo-grupo">
                            <Rotulo Texto="Saldo de conforto" Para="conforto"
                                    Ajuda="Abaixo dele, o app avisa, mesmo sem ficar negativo. Pode ser zero." />
                            <CampoDinheiro Valor="_cfg.SaldoConfortoCentavos" ValorChanged="v => _cfg.SaldoConfortoCentavos = v" Id="conforto" />
                        </div>
                        <div class="campo-grupo">
                            <Rotulo Texto="Já guardado" Para="guardado"
                                    Ajuda="O que você já tinha guardado antes. Só para acompanhar as economias; não entra no saldo da conta." />
                            <CampoDinheiro Valor="_cfg.JaGuardadoCentavos" ValorChanged="v => _cfg.JaGuardadoCentavos = v" Id="guardado" />
                        </div>
                    </div>

                    <div class="campo-grupo">
                        <Rotulo Texto="Previsão até" Para="horizonte" />
                        <select id="horizonte" class="campo" @bind="_cfg.HorizonteMeses">
                            <option value="12">12 meses</option>
                            <option value="24">24 meses</option>
                            <option value="36">36 meses</option>
                            <option value="60">60 meses</option>
                        </select>
                    </div>

                    <div class="campo-grupo">
                        <label class="interruptor">
                            Contar entradas incertas
                            <input type="checkbox" role="switch" @bind="_cfg.ContarEntradasIncertas" />
                        </label>
                        <div class="dica">
                            @(_cfg.ContarEntradasIncertas
                                ? "Entradas incertas entram no saldo previsto."
                                : "Entradas incertas ficam fora do saldo previsto.")
                        </div>
                    </div>

                    @if (_erros.Count > 0)
                    {
                        <Aviso Tipo="ruim" Papel="alert">
                            @foreach (var erro in _erros)
                            {
                                <div>@erro</div>
                            }
                        </Aviso>
                    }

                    <div class="acoes">
                        <button type="button" class="btn" @onclick="SalvarConfiguracao" disabled="@_salvando">
                            @(_salvando ? "Salvando..." : "Salvar")
                        </button>
                    </div>

                    @if (_mensagem is not null)
                    {
                        <div style="margin-top:12px">
                            <Aviso Tipo="bom" Papel="status">@_mensagem</Aviso>
                        </div>
                    }
                </div>
            </Grupo>
        </div>

        <div>
            @* ---------- Carteiras ---------- *@
            <Grupo Titulo="Carteiras">
                <Acoes>
                    <button type="button" class="btn texto pequeno" @onclick="() => AbrirCarteira(null)">
                        <Icone Nome="mais" Tamanho="18" /> Nova
                    </button>
                </Acoes>
                <ChildContent>
                    <ul class="lista">
                        <li>
                            <div class="item">
                                <span class="icone-tipo neutro"><Icone Nome="banco" Tamanho="20" /></span>
                                <span class="item-principal">
                                    <span class="item-titulo">Conta corrente</span>
                                    <span class="item-sub">Contas e faturas saem daqui</span>
                                </span>
                            </div>
                        </li>
                        @foreach (var carteira in _dados.Carteiras)
                        {
                            <li>
                                <button type="button" class="item" @onclick="() => AbrirCarteira(carteira)"
                                        aria-label="Editar a carteira @carteira.Nome">
                                    <span class="icone-tipo neutro"><Icone Nome="carteira" Tamanho="20" /></span>
                                    <span class="item-principal">
                                        <span class="item-titulo">@carteira.Nome</span>
                                        <span class="item-sub">
                                            @(carteira.DiarioPrevistoCentavos is long d ? $"diário de {Formato.Moeda(d)}" : "sem diário")
                                        </span>
                                    </span>
                                    <span class="item-valor">
                                        <Valor Centavos="carteira.SaldoAncoraCentavos" />
                                        <span class="item-valor-sub">em @Formato.DataCurta(carteira.DataAncora)</span>
                                    </span>
                                    <span class="item-seta"><Icone Nome="seta" Tamanho="18" /></span>
                                </button>
                            </li>
                        }
                    </ul>
                </ChildContent>
            </Grupo>

            @* ---------- Cartões ---------- *@
            <Grupo Titulo="Cartões" Id="cartoes">
                <Acoes>
                    @if (_dados.Cartoes.Count > 0)
                    {
                        <button type="button" class="btn texto pequeno" @onclick="() => AbrirCartao(null)">
                            <Icone Nome="mais" Tamanho="18" /> Novo
                        </button>
                    }
                </Acoes>
                <ChildContent>
                    @if (_dados.Cartoes.Count == 0)
                    {
                        <Vazio Texto="Nenhum cartão cadastrado.">
                            <button type="button" class="btn secundario" @onclick="() => AbrirCartao(null)">Adicionar</button>
                        </Vazio>
                    }
                    else
                    {
                        <ul class="lista">
                            @foreach (var cartao in _dados.Cartoes)
                            {
                                <li>
                                    <button type="button" class="item" @onclick="() => AbrirCartao(cartao)"
                                            aria-label="Editar o cartão @cartao.Nome">
                                        <span class="icone-tipo cartao"><Icone Nome="cartao" Tamanho="20" /></span>
                                        <span class="item-principal">
                                            <span class="item-titulo">@cartao.Nome</span>
                                            <span class="item-sub">Fecha dia @cartao.DiaFechamento, vence dia @cartao.DiaVencimento</span>
                                        </span>
                                        <span class="item-seta"><Icone Nome="seta" Tamanho="18" /></span>
                                    </button>
                                </li>
                            }
                            <li>
                                <a class="item" href="lancamentos?secao=faturas">
                                    <span class="icone-tipo neutro"><Icone Nome="fatura" Tamanho="20" /></span>
                                    <span class="item-principal"><span class="item-titulo">Faturas</span></span>
                                    <span class="item-seta"><Icone Nome="seta" Tamanho="18" /></span>
                                </a>
                            </li>
                        </ul>
                    }
                </ChildContent>
            </Grupo>

            @* ---------- Tags ---------- *@
            <Grupo Titulo="Tags">
                <div class="corpo">
                    <div class="linha-campo-botao">
                        <input class="campo" placeholder="Casa, mercado, transporte" aria-label="Nova tag"
                               autocomplete="off" @bind="_novaTag" />
                        <button type="button" class="btn secundario" @onclick="AdicionarTag">Adicionar</button>
                    </div>
                </div>
                @if (_dados.Tags.Count > 0)
                {
                    <ul class="lista">
                        @foreach (var tag in _dados.Tags)
                        {
                            <li>
                                <button type="button" class="item" style="min-height:52px" @onclick="() => AbrirTag(tag)"
                                        aria-label="Editar a tag @tag.Nome">
                                    <span class="item-principal">
                                        <span><span class="pilula @Formato.ClasseTag(tag.Cor)">@tag.Nome</span></span>
                                    </span>
                                    <span class="item-seta"><Icone Nome="seta" Tamanho="18" /></span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </Grupo>

            @* ---------- Backup ---------- *@
            <Grupo Titulo="Backup">
                <ul class="lista">
                    <li>
                        <a class="item" href="backup/baixar" target="_blank">
                            <span class="icone-tipo neutro"><Icone Nome="baixar" Tamanho="20" /></span>
                            <span class="item-principal">
                                <span class="item-titulo">Baixar backup</span>
                                <span class="item-sub">Arquivo JSON com tudo</span>
                            </span>
                        </a>
                    </li>
                </ul>
                <div class="corpo">
                    <Rotulo Texto="Restaurar de um arquivo" Para="arquivo"
                            Ajuda="Substitui tudo que está no app pelo conteúdo do arquivo. Antes de trocar, o app mostra o que o arquivo tem e guarda uma cópia do estado atual." />
                    <InputFile id="arquivo" class="campo" accept=".json" OnChange="ArquivoEscolhido" />

                    @if (_restauracao is not null)
                    {
                        <div style="margin-top:12px">
                            @if (_restauracao.Erros.Count > 0)
                            {
                                <Aviso Tipo="ruim" Papel="alert">
                                    <strong>Esse arquivo não serve.</strong>
                                    @foreach (var erro in _restauracao.Erros)
                                    {
                                        <div>@erro</div>
                                    }
                                </Aviso>
                            }
                            else if (_restauracao.BackupDoQueExistia is not null)
                            {
                                <Aviso Tipo="bom" Papel="status">
                                    Restaurado. O que existia antes foi salvo em <code>@_restauracao.BackupDoQueExistia</code>
                                </Aviso>
                            }
                            else
                            {
                                <Aviso Tipo="atencao">
                                    <strong>O arquivo tem:</strong>
                                    @foreach (var item in _restauracao.Resumo)
                                    {
                                        <div>@item</div>
                                    }
                                    <p style="margin-top:8px">Restaurar troca tudo que está no app por isso. Não mistura.</p>
                                    <div class="acoes inicio">
                                        <button type="button" class="btn perigo-cheio pequeno" @onclick="ConfirmarRestauracao">
                                            Substituir tudo
                                        </button>
                                        <button type="button" class="btn contorno pequeno" @onclick="CancelarRestauracao">
                                            Cancelar
                                        </button>
                                    </div>
                                </Aviso>
                            }
                        </div>
                    }
                </div>
            </Grupo>

            @* ---------- Sobre ---------- *@
            <Grupo Titulo="Sobre">
                <dl class="linhas corpo" style="padding-top:4px; padding-bottom:4px">
                    <div class="linha">
                        <dt>Versão</dt>
                        <dd>@Info.Versao</dd>
                    </div>
                    <div class="linha" style="flex-direction:column; align-items:flex-start; gap:2px">
                        <dt>Dados em</dt>
                        <dd style="white-space:normal; text-align:left"><code>@Info.CaminhoBanco</code></dd>
                    </div>
                </dl>
                @if (_ancoras.Count > 0)
                {
                    <details class="detalhes">
                        <summary>
                            Conferências anteriores
                            <Icone Nome="abrir" Tamanho="18" />
                        </summary>
                        <ul class="lista">
                            @foreach (var ancora in _ancoras.Take(8))
                            {
                                <li>
                                    <div class="item" style="min-height:52px">
                                        <span class="item-principal">
                                            <span class="item-titulo">@Formato.Data(ancora.Data)</span>
                                            @if (!string.IsNullOrWhiteSpace(ancora.Observacao))
                                            {
                                                <span class="item-sub">@ancora.Observacao</span>
                                            }
                                        </span>
                                        <span class="item-valor"><Valor Centavos="ancora.SaldoCentavos" /></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </details>
                }
            </Grupo>
        </div>
    </div>
}

@if (_carteiraEditando is not null)
{
    <Modal Titulo="@(_carteiraEditando.Id == 0 ? "Nova carteira" : "Editar carteira")" AoFechar="FecharCarteira">
        <ChildContent>
            <p class="dica" style="margin:0 0 16px">
                Vale-alimentação e vale-transporte têm saldo próprio: o benefício não paga aluguel.
            </p>

            <div class="campo-grupo">
                <Rotulo Texto="Nome" Para="nome-carteira" />
                <input id="nome-carteira" class="campo" @bind="_carteiraEditando.Nome" autocomplete="off"
                       placeholder="Vale-alimentação" />
            </div>

            <div class="linha-campos">
                <div class="campo-grupo">
                    <Rotulo Texto="Saldo" Para="saldo-carteira" />
                    <CampoDinheiro Valor="_carteiraEditando.SaldoAncoraCentavos"
                                   ValorChanged="v => _carteiraEditando.SaldoAncoraCentavos = v" Id="saldo-carteira" />
                </div>
                <div class="campo-grupo">
                    <Rotulo Texto="No início de" Para="data-carteira" />
                    <CampoData Valor="_carteiraEditando.DataAncora"
                               ValorChanged="v => _carteiraEditando.DataAncora = v ?? Relogio.Hoje" Id="data-carteira" />
                </div>
            </div>

            <div class="campo-grupo">
                <label class="interruptor">
                    Tem gasto por dia
                    <input type="checkbox" role="switch" checked="@(_carteiraEditando.DiarioPrevistoCentavos is not null)"
                           @onchange="TrocarDiarioDaCarteira" />
                </label>
                <div class="dica">
                    @(_carteiraEditando.DiarioPrevistoCentavos is null
                        ? "Sem gasto por dia, só desconta o que você registrar. Não aparece em Gasto de hoje."
                        : "Desconta o valor abaixo todo dia sem registro, como no vale-transporte.")
                </div>
            </div>

            @if (_carteiraEditando.DiarioPrevistoCentavos is long diarioCarteira)
            {
                <div class="campo-grupo">
                    <Rotulo Texto="Diário previsto" Para="diario-carteira" />
                    <CampoDinheiro Valor="diarioCarteira"
                                   ValorChanged="v => _carteiraEditando.DiarioPrevistoCentavos = v" Id="diario-carteira" />
                </div>
            }

            <div class="campo-grupo">
                <Rotulo Texto="Saldo de conforto" Para="conforto-carteira"
                        Ajuda="Abaixo dele, o app avisa sobre esta carteira. Pode ser zero." />
                <CampoDinheiro Valor="_carteiraEditando.SaldoConfortoCentavos"
                               ValorChanged="v => _carteiraEditando.SaldoConfortoCentavos = v" Id="conforto-carteira" />
            </div>

            @if (_errosCarteira.Count > 0)
            {
                <Aviso Tipo="ruim" Papel="alert">
                    @foreach (var erro in _errosCarteira)
                    {
                        <div>@erro</div>
                    }
                </Aviso>
            }
        </ChildContent>
        <Rodape>
            <button type="button" class="btn" @onclick="SalvarCarteira" disabled="@_salvandoCarteira">
                @(_salvandoCarteira ? "Salvando..." : "Salvar")
            </button>
            @if (_carteiraEditando.Id != 0)
            {
                <button type="button" class="btn @(_confirmandoExclusao ? "perigo-cheio" : "perigo")" @onclick="ExcluirCarteira">
                    @(_confirmandoExclusao ? "Excluir de vez" : "Excluir")
                </button>
            }
        </Rodape>
    </Modal>
}

@if (_cartaoEditando is not null)
{
    <Modal Titulo="@(_cartaoEditando.Id == 0 ? "Novo cartão" : "Editar cartão")" AoFechar="FecharCartao">
        <ChildContent>
            <div class="campo-grupo">
                <Rotulo Texto="Nome" Para="nome-cartao" />
                <input id="nome-cartao" class="campo" @bind="_cartaoEditando.Nome" autocomplete="off" placeholder="Principal" />
            </div>

            <div class="linha-campos">
                <div class="campo-grupo">
                    <Rotulo Texto="Fecha dia" Para="fechamento"
                            Ajuda="Compra feita no próprio dia do fechamento já vai para a fatura seguinte." />
                    <input id="fechamento" type="number" inputmode="numeric" min="1" max="31" class="campo"
                           @bind="_cartaoEditando.DiaFechamento" />
                </div>
                <div class="campo-grupo">
                    <Rotulo Texto="Vence dia" Para="vencimento" />
                    <input id="vencimento" type="number" inputmode="numeric" min="1" max="31" class="campo"
                           @bind="_cartaoEditando.DiaVencimento" />
                </div>
            </div>

            <div class="campo-grupo">
                <Rotulo Texto="Juros do rotativo ao mês" Para="juros-cartao"
                        Ajuda="Só entra na conta quando a fatura passa do vencimento sem ser paga. Deixe zero se não souber: o app não inventa juros." />
                <div class="campo-dinheiro">
                    <input id="juros-cartao" type="number" inputmode="decimal" min="0" max="50" step="0.1"
                           class="campo com-sufixo" @bind="_jurosPercentual" />
                    <span class="campo-dinheiro-sufixo">%</span>
                </div>
            </div>

            @if (_errosCartao.Count > 0)
            {
                <Aviso Tipo="ruim" Papel="alert">
                    @foreach (var erro in _errosCartao)
                    {
                        <div>@erro</div>
                    }
                </Aviso>
            }
        </ChildContent>
        <Rodape>
            <button type="button" class="btn" @onclick="SalvarCartao" disabled="@_salvandoCartao">
                @(_salvandoCartao ? "Salvando..." : "Salvar")
            </button>
            @if (_cartaoEditando.Id != 0)
            {
                <button type="button" class="btn @(_confirmandoExclusao ? "perigo-cheio" : "perigo")" @onclick="ExcluirCartao">
                    @(_confirmandoExclusao ? "Excluir de vez" : "Excluir")
                </button>
            }
        </Rodape>
    </Modal>
}

@if (_tagEditando is not null)
{
    <Modal Titulo="Editar tag" AoFechar="() => _tagEditando = null">
        <ChildContent>
            <div class="campo-grupo">
                <Rotulo Texto="Nome" Para="nome-tag" />
                <input id="nome-tag" class="campo" @bind="_tagEditando.Nome" autocomplete="off" />
            </div>

            @* Radio, não botão: a escolha é uma só entre várias, e o teclado anda entre elas
               com as setas de graça. *@
            <fieldset class="cores">
                <legend class="rotulo-texto" style="margin-bottom:8px; padding:0">Cor</legend>
                @foreach (var cor in Formato.CoresDeTag)
                {
                    var id = $"cor-{cor}";
                    <input type="radio" id="@id" name="cor-tag" checked="@(_tagEditando.Cor == cor)"
                           @onchange="() => _tagEditando!.Cor = cor" />
                    <label for="@id" class="pilula @Formato.ClasseTag(cor)" title="@cor" aria-label="@cor"></label>
                }
            </fieldset>

            <div style="margin-top:16px">
                <span class="pilula @Formato.ClasseTag(_tagEditando.Cor)">@(string.IsNullOrWhiteSpace(_tagEditando.Nome) ? "Tag" : _tagEditando.Nome)</span>
            </div>

            @if (_errosTag.Count > 0)
            {
                <div style="margin-top:12px">
                    <Aviso Tipo="ruim" Papel="alert">
                        @foreach (var erro in _errosTag)
                        {
                            <div>@erro</div>
                        }
                    </Aviso>
                </div>
            }
        </ChildContent>
        <Rodape>
            <button type="button" class="btn" @onclick="SalvarTag">Salvar</button>
            <button type="button" class="btn @(_confirmandoExclusao ? "perigo-cheio" : "perigo")" @onclick="ExcluirTag">
                @(_confirmandoExclusao ? "Excluir de vez" : "Excluir")
            </button>
        </Rodape>
    </Modal>
}

@code {
    private Configuracao? _cfg;
    private DadosPlanejamento? _dados;
    private List<AncoraHistorico> _ancoras = [];
    private long? _saldoProjetadoHoje;
    private long _saldoReal;
    private string? _mensagem;
    private string? _mensagemConferencia;
    private List<string> _erros = [];

    private Cartao? _cartaoEditando;
    private List<string> _errosCartao = [];
    private decimal _jurosPercentual;
    private bool _salvandoCartao;
    private Carteira? _carteiraEditando;
    private List<string> _errosCarteira = [];
    private bool _salvandoCarteira;
    private Tag? _tagEditando;
    private List<string> _errosTag = [];
    private string _novaTag = "";
    private bool _salvando;
    private bool _salvandoConferencia;
    private bool _confirmandoExclusao;

    private ResultadoRestauracao? _restauracao;
    private string? _jsonParaRestaurar;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _dados = await Servico.CarregarAsync();
        _cfg = _dados.Configuracao;
        _ancoras = await Servico.ObterHistoricoAncorasAsync();

        var projecao = Servico.Projetar(_dados, null, Relogio.Hoje);

        // O numero a comparar com o banco e o saldo do FIM de hoje, que e o mesmo que o
        // saldo do inicio de amanha. Depois de uma recalibracao a ancora passa a ser amanha,
        // e ai hoje fica fora da projecao: nesse caso o saldo do fim de hoje e a propria
        // ancora. Sem este segundo caso a tela sumiria logo apos conferir.
        _saldoProjetadoHoje = _cfg.DataAncora <= Relogio.Hoje
            ? projecao.Dia(Relogio.Hoje)?.SaldoCentavos
            : _cfg.DataAncora == Relogio.Hoje.AddDays(1)
                ? _cfg.SaldoAncoraCentavos
                : null;

        _saldoReal = _saldoProjetadoHoje ?? 0;
    }

    private async Task SalvarConfiguracao()
    {
        if (_cfg is null)
        {
            return;
        }

        _mensagem = null;
        _erros = Validacao.Configuracao(_cfg);

        if (_erros.Count > 0)
        {
            return;
        }

        _salvando = true;

        try
        {
            await Servico.SalvarConfiguracaoAsync(_cfg, "Ajuste manual");
            _mensagem = "Salvo.";
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task Recalibrar()
    {
        // Dois toques criariam duas ancoras no historico.
        if (_salvandoConferencia)
        {
            return;
        }

        _salvandoConferencia = true;

        try
        {
            await Servico.RecalibrarAsync(_saldoReal, Relogio.Hoje);
            _mensagemConferencia = $"Saldo atualizado para {Formato.Moeda(_saldoReal)}. " +
                                   $"Vale a partir de {Formato.Data(Relogio.Hoje.AddDays(1))}.";
            await CarregarAsync();
        }
        finally
        {
            _salvandoConferencia = false;
        }
    }

    private void AbrirCarteira(Carteira? original)
    {
        _errosCarteira = [];
        _confirmandoExclusao = false;

        // Copia, para cancelar nao deixar a lista com dados meio editados.
        _carteiraEditando = original is null
            ? new Carteira { Nome = "", Tipo = TipoCarteira.Beneficio, DataAncora = Relogio.Hoje }
            : new Carteira
            {
                Id = original.Id,
                Nome = original.Nome,
                Tipo = original.Tipo,
                SaldoAncoraCentavos = original.SaldoAncoraCentavos,
                DataAncora = original.DataAncora,
                DiarioPrevistoCentavos = original.DiarioPrevistoCentavos,
                SaldoConfortoCentavos = original.SaldoConfortoCentavos,
                Ordem = original.Ordem
            };
    }

    private void FecharCarteira()
    {
        _carteiraEditando = null;
        _confirmandoExclusao = false;
    }

    /// <summary>
    /// null e "carteira sem diario", que e diferente de diario zero: zero desconta zero todo
    /// dia, null nao desconta nada e nem aparece no check-in.
    /// </summary>
    private void TrocarDiarioDaCarteira(ChangeEventArgs evento)
    {
        if (_carteiraEditando is not null)
        {
            _carteiraEditando.DiarioPrevistoCentavos = evento.Value is true ? 0 : null;
        }
    }

    private async Task SalvarCarteira()
    {
        if (_carteiraEditando is null)
        {
            return;
        }

        _errosCarteira = Validacao.Carteira(_carteiraEditando);

        if (_errosCarteira.Count > 0)
        {
            return;
        }

        _salvandoCarteira = true;

        try
        {
            await Servico.SalvarCarteiraAsync(_carteiraEditando);
            FecharCarteira();
            await CarregarAsync();
        }
        finally
        {
            _salvandoCarteira = false;
        }
    }

    private async Task ExcluirCarteira()
    {
        if (_carteiraEditando is not { Id: > 0 } carteira)
        {
            return;
        }

        if (!_confirmandoExclusao)
        {
            _confirmandoExclusao = true;
            return;
        }

        var impedimento = await Servico.ExcluirCarteiraAsync(carteira.Id);

        if (impedimento is not null)
        {
            _errosCarteira = [impedimento];
            _confirmandoExclusao = false;
            return;
        }

        FecharCarteira();
        await CarregarAsync();
    }

    private void AbrirCartao(Cartao? original)
    {
        _errosCartao = [];
        _confirmandoExclusao = false;

        // Guardado como fração (0,15), digitado como porcentagem (15): o dono pensa em "15% ao
        // mês", e o motor precisa do fator para multiplicar.
        _jurosPercentual = (original?.JurosRotativoMensal ?? 0m) * 100m;

        _cartaoEditando = original is null
            ? new Cartao { Nome = "", DiaFechamento = 1, DiaVencimento = 10 }
            : new Cartao
            {
                Id = original.Id,
                Nome = original.Nome,
                DiaFechamento = original.DiaFechamento,
                DiaVencimento = original.DiaVencimento,
                JurosRotativoMensal = original.JurosRotativoMensal
            };
    }

    private void FecharCartao()
    {
        _cartaoEditando = null;
        _confirmandoExclusao = false;
    }

    private async Task SalvarCartao()
    {
        if (_cartaoEditando is null || _salvandoCartao)
        {
            return;
        }

        _cartaoEditando.JurosRotativoMensal = _jurosPercentual / 100m;
        _errosCartao = Validacao.Cartao(_cartaoEditando);

        if (_errosCartao.Count > 0)
        {
            return;
        }

        _salvandoCartao = true;

        try
        {
            await Servico.SalvarCartaoAsync(_cartaoEditando);
            FecharCartao();
            await CarregarAsync();
        }
        finally
        {
            _salvandoCartao = false;
        }
    }

    private async Task ExcluirCartao()
    {
        if (_cartaoEditando is not { Id: > 0 } cartao)
        {
            return;
        }

        if (!_confirmandoExclusao)
        {
            _confirmandoExclusao = true;
            return;
        }

        var impedimento = await Servico.ExcluirCartaoAsync(cartao.Id);

        if (impedimento is not null)
        {
            _errosCartao = [impedimento];
            _confirmandoExclusao = false;
            return;
        }

        FecharCartao();
        await CarregarAsync();
    }

    private async Task AdicionarTag()
    {
        if (string.IsNullOrWhiteSpace(_novaTag))
        {
            return;
        }

        await Servico.SalvarTagAsync(new Tag { Nome = _novaTag.Trim() });
        _novaTag = "";
        await CarregarAsync();
    }

    private void AbrirTag(Tag original)
    {
        _errosTag = [];
        _confirmandoExclusao = false;
        _tagEditando = new Tag { Id = original.Id, Nome = original.Nome, Cor = original.Cor };
    }

    private async Task SalvarTag()
    {
        if (_tagEditando is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_tagEditando.Nome))
        {
            _errosTag = ["Dê um nome à tag."];
            return;
        }

        _tagEditando.Nome = _tagEditando.Nome.Trim();
        await Servico.SalvarTagAsync(_tagEditando);
        _tagEditando = null;
        await CarregarAsync();
    }

    /// <summary>Excluir pede um segundo toque. Os lançamentos com a tag ficam sem tag, não somem.</summary>
    private async Task ExcluirTag()
    {
        if (_tagEditando is null)
        {
            return;
        }

        if (!_confirmandoExclusao)
        {
            _confirmandoExclusao = true;
            return;
        }

        await Servico.ExcluirTagAsync(_tagEditando.Id);
        _tagEditando = null;
        _confirmandoExclusao = false;
        await CarregarAsync();
    }

    private async Task ArquivoEscolhido(InputFileChangeEventArgs evento)
    {
        _restauracao = null;
        _jsonParaRestaurar = null;

        using var leitor = new StreamReader(evento.File.OpenReadStream(maxAllowedSize: 32 * 1024 * 1024));
        _jsonParaRestaurar = await leitor.ReadToEndAsync();

        // Primeiro so confere e mostra o que vem no arquivo.
        _restauracao = await Backup.RestaurarAsync(_jsonParaRestaurar, confirmar: false);
    }

    private void CancelarRestauracao()
    {
        _restauracao = null;
        _jsonParaRestaurar = null;
    }

    private async Task ConfirmarRestauracao()
    {
        if (_jsonParaRestaurar is null)
        {
            return;
        }

        _restauracao = await Backup.RestaurarAsync(_jsonParaRestaurar, confirmar: true);
        _jsonParaRestaurar = null;
        await CarregarAsync();
    }
}
