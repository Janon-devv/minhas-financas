@page "/comecar"
@layout LayoutLimpo
@inject PlanejamentoService Servico
@inject IRelogio Relogio

<PageTitle>Começar | Minhas Finanças</PageTitle>

@if (_cfg is null)
{
    <Cabecalho Titulo="Começar" Marca="true" />
    <Carregando />
}
else
{
    @* O guia inteiro mostra em que passo está e quanto falta. Sem isso o cadastro parece não
       ter fim, e quem desiste no meio desiste sem saber o que ainda faltava. *@
    <Cabecalho Titulo="@TituloDoPasso()" Marca="true">
        <Acoes>
            @if (_passo > PassoNumeros3 && _passo < PassoPronto)
            {
                @* Link, nao botao: sair do guia e navegacao, e com botao o Ctrl+clique e o clique
                   do meio param de abrir em outra aba. *@
                <a class="btn sobre-escuro pequeno" href="">Sair do guia</a>
            }
        </Acoes>
        <ChildContent>
            @if (_passo < PassoPronto)
            {
                <p class="hero-nota" style="margin-top:12px">Passo @_passo de @TotalPassos</p>
                <div class="passos" aria-hidden="true">
                    @for (var i = 1; i <= TotalPassos; i++)
                    {
                        <span class="@(i <= _passo ? "feito" : "")"></span>
                    }
                </div>
            }
        </ChildContent>
    </Cabecalho>

    @if (_passo == PassoNumeros1)
    {
        <Grupo>
            <div class="corpo">
                <p class="dica" style="margin:0 0 16px">Primeiro seus números, depois o que entra e o que sai. Dá para pular o cadastro.</p>

                <div class="campo-grupo">
                    <Rotulo Texto="Saldo na conta" Para="saldo"
                            Ajuda="O saldo no início do dia, antes dos gastos desse dia. Se o banco já mostra um gasto de hoje, não registre esse gasto de novo no gasto do dia. Pode ser negativo." />
                    <CampoDinheiro Valor="_cfg.SaldoAncoraCentavos" ValorChanged="v => _cfg.SaldoAncoraCentavos = v" Id="saldo" />
                </div>

                <div class="campo-grupo">
                    <Rotulo Texto="No início de" Para="data" />
                    <CampoData Valor="_cfg.DataAncora" ValorChanged="v => _cfg.DataAncora = v ?? Relogio.Hoje" Id="data" />
                    <div class="dica">Normalmente hoje, @Formato.Data(Relogio.Hoje).</div>
                </div>
            </div>
        </Grupo>

        <div class="acoes">
            <button type="button" class="btn largo" @onclick="() => _passo = PassoNumeros2">Continuar</button>
        </div>
    }
    else if (_passo == PassoNumeros2)
    {
        <Grupo>
            <div class="corpo">
                <div class="campo-grupo">
                    <Rotulo Texto="Gasto diário previsto" Para="diario"
                            Ajuda="Gastos miúdos de todo dia: lanche, transporte, mercado de passagem. Nada que vá ser cadastrado como conta. Na dúvida, erre para mais." />
                    <CampoDinheiro Valor="_cfg.DiarioPrevistoCentavos" ValorChanged="v => _cfg.DiarioPrevistoCentavos = v" Id="diario" />
                </div>

                <div class="campo-grupo">
                    <label class="interruptor">
                        Descontar todo dia
                        <input type="checkbox" role="switch" @bind="_cfg.DiarioPrevistoAtivo" />
                    </label>
                    <div class="dica">
                        @(_cfg.DiarioPrevistoAtivo
                            ? "Dia sem registro conta esse valor."
                            : "Dia sem registro conta zero. Bom para quem gasta em compras de vez em quando, que entram como conta no próximo passo.")
                    </div>
                </div>
            </div>
        </Grupo>

        <div class="acoes">
            <button type="button" class="btn contorno" @onclick="() => _passo = PassoNumeros1">Voltar</button>
            <button type="button" class="btn" @onclick="() => _passo = PassoNumeros3">Continuar</button>
        </div>
    }
    else if (_passo == PassoNumeros3)
    {
        <Grupo>
            <div class="corpo">
                <div class="campo-grupo">
                    <Rotulo Texto="Saldo de conforto" Para="conforto"
                            Ajuda="Abaixo dele, o app avisa, mesmo sem ficar negativo. Pode ser zero, se você só quer o aviso de saldo negativo." />
                    <CampoDinheiro Valor="_cfg.SaldoConfortoCentavos" ValorChanged="v => _cfg.SaldoConfortoCentavos = v" Id="conforto" />
                </div>

                <div class="campo-grupo">
                    <Rotulo Texto="Já guardado" Para="guardado"
                            Ajuda="Só para acompanhar o que você economiza. Não entra no saldo da conta." />
                    <CampoDinheiro Valor="_cfg.JaGuardadoCentavos" ValorChanged="v => _cfg.JaGuardadoCentavos = v" Id="guardado" />
                </div>

                @if (_erros.Count > 0)
                {
                    <Aviso Tipo="ruim" Papel="alert">
                        @foreach (var erro in _erros)
                        {
                            <div>@erro</div>
                        }
                    </Aviso>
                }
            </div>
        </Grupo>

        <div class="acoes">
            <button type="button" class="btn contorno" @onclick="() => _passo = PassoNumeros2">Voltar</button>
            <button type="button" class="btn" @onclick="SalvarNumerosAsync" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar e continuar")
            </button>
        </div>
    }
    else if (_passo == PassoEntradas || _passo == PassoFixas)
    {
        var ehEntrada = _passo == PassoEntradas;
        var itens = ItensDoPasso();

        @if (_confirmacao is not null)
        {
            <div style="margin-top:16px">
                <Aviso Tipo="bom" Papel="status">@_confirmacao</Aviso>
            </div>
        }

        @if (itens.Count > 0)
        {
            <Grupo Titulo="@(ehEntrada ? "Entradas" : "Contas")">
                <ul class="lista">
                    @foreach (var item in itens)
                    {
                        <li>
                            <div class="item">
                                <IconeTipo Tipo="item.Tipo" />
                                <span class="item-principal">
                                    <span class="item-titulo">@item.Descricao</span>
                                    <span class="item-sub">@(ehEntrada ? "Cai em " : "Sai em ")@Formato.Data(item.Data)</span>
                                </span>
                                <span class="item-valor">
                                    <Valor Centavos="item.ValorCentavos" Classe="@(ehEntrada ? "valor-entrada" : null)" />
                                    <span class="item-valor-sub">@Formato.Repeticao(item.Vezes, item.Periodicidade)</span>
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </Grupo>
        }

        @if (_novo is null)
        {
            <div class="acoes">
                <button type="button" class="btn secundario largo" @onclick="AbrirFormulario">
                    <Icone Nome="mais" Tamanho="18" />
                    @(ehEntrada ? "Adicionar entrada" : "Adicionar conta")
                </button>
            </div>
        }
        else
        {
            <Grupo Titulo="@(ehEntrada ? "Nova entrada" : "Nova conta")">
                <div class="corpo">
                    <p class="dica" style="margin:0 0 16px">
                        @(ehEntrada
                            ? "Salário, freela, aluguel que você recebe. Comece pelo que é certo."
                            : "Aluguel, internet, academia, a compra da semana. Comece pela maior.")
                    </p>

                    <div class="campo-grupo">
                        <Rotulo Texto="Descrição" Para="descricao" />
                        <input id="descricao" class="campo" @bind="_novo.Descricao" autocomplete="off"
                               placeholder="@(ehEntrada ? "Salário" : "Aluguel")" />
                    </div>

                    <div class="linha-campos">
                        <div class="campo-grupo">
                            <Rotulo Texto="Valor de cada vez" Para="valor"
                                    Ajuda="O valor de uma vez, não o total do ano." />
                            <CampoDinheiro Valor="_novo.ValorCentavos" ValorChanged="v => _novo.ValorCentavos = v" Id="valor" />
                        </div>
                        <div class="campo-grupo">
                            <Rotulo Texto="@(ehEntrada ? "Cai em" : "Sai em")" Para="data-item" />
                            <CampoData Valor="_novo.Data" ValorChanged="v => _novo.Data = v ?? Relogio.Hoje" Id="data-item" />
                        </div>
                    </div>

                    <div class="campo-grupo">
                        <Rotulo Texto="Repetição" Para="repeticao" />
                        <select id="repeticao" class="campo" value="@_repeticao" @onchange="TrocarRepeticao">
                            <option value="mensal">Todo mês</option>
                            <option value="uma">Uma vez</option>
                        </select>
                    </div>

                    @if (_errosItem.Count > 0)
                    {
                        <Aviso Tipo="ruim" Papel="alert">
                            @foreach (var erro in _errosItem)
                            {
                                <div>@erro</div>
                            }
                        </Aviso>
                    }

                    <div class="acoes">
                        <button type="button" class="btn" @onclick="SalvarItemAsync" disabled="@_salvando">
                            @(_salvando ? "Salvando..." : "Salvar")
                        </button>
                        <button type="button" class="btn contorno" @onclick="FecharFormulario">Cancelar</button>
                    </div>
                </div>
            </Grupo>
        }

        <div class="acoes" style="margin-top:24px">
            <button type="button" class="btn contorno" @onclick="Voltar">Voltar</button>
            <button type="button" class="@ClasseAvancar" @onclick="Avancar">
                @(itens.Count > 0 ? "Continuar" : "Pular")
            </button>
        </div>
    }
    else if (_passo == PassoCartoes)
    {
        var cartoes = _dados?.Cartoes ?? [];

        @if (_confirmacao is not null)
        {
            <div style="margin-top:16px">
                <Aviso Tipo="bom" Papel="status">@_confirmacao</Aviso>
            </div>
        }

        @if (cartoes.Count > 0)
        {
            <Grupo Titulo="Cartões">
                <ul class="lista">
                    @foreach (var cartao in cartoes)
                    {
                        <li>
                            <div class="item">
                                <span class="icone-tipo cartao"><Icone Nome="cartao" Tamanho="20" /></span>
                                <span class="item-principal">
                                    <span class="item-titulo">@cartao.Nome</span>
                                    <span class="item-sub">Fecha dia @cartao.DiaFechamento, vence dia @cartao.DiaVencimento</span>
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </Grupo>
        }

        @if (_novoCartao is null)
        {
            <div class="acoes">
                <button type="button" class="btn secundario largo" @onclick="AbrirFormularioCartao">
                    <Icone Nome="mais" Tamanho="18" /> Adicionar cartão
                </button>
            </div>
        }
        else
        {
            <Grupo Titulo="Novo cartão">
                <div class="corpo">
                    <p class="dica" style="margin:0 0 16px">Com o dia que fecha e o que vence, o app sabe quando a fatura sai da conta.</p>

                    <div class="campo-grupo">
                        <Rotulo Texto="Nome" Para="nome-cartao" />
                        <input id="nome-cartao" class="campo" @bind="_novoCartao.Nome" autocomplete="off" placeholder="Principal" />
                    </div>

                    <div class="linha-campos">
                        <div class="campo-grupo">
                            <Rotulo Texto="Fecha dia" Para="fechamento" />
                            <input id="fechamento" type="number" inputmode="numeric" min="1" max="31" class="campo"
                                   @bind="_novoCartao.DiaFechamento" />
                        </div>
                        <div class="campo-grupo">
                            <Rotulo Texto="Vence dia" Para="vencimento" />
                            <input id="vencimento" type="number" inputmode="numeric" min="1" max="31" class="campo"
                                   @bind="_novoCartao.DiaVencimento" />
                        </div>
                    </div>

                    @if (_errosItem.Count > 0)
                    {
                        <Aviso Tipo="ruim" Papel="alert">
                            @foreach (var erro in _errosItem)
                            {
                                <div>@erro</div>
                            }
                        </Aviso>
                    }

                    <div class="acoes">
                        <button type="button" class="btn" @onclick="SalvarCartaoAsync" disabled="@_salvando">
                            @(_salvando ? "Salvando..." : "Salvar")
                        </button>
                        <button type="button" class="btn contorno" @onclick="FecharFormulario">Cancelar</button>
                    </div>
                </div>
            </Grupo>
        }

        <div class="acoes" style="margin-top:24px">
            <button type="button" class="btn contorno" @onclick="Voltar">Voltar</button>
            <button type="button" class="@ClasseAvancar" @onclick="Avancar">
                @(cartoes.Count > 0 ? "Continuar" : "Pular")
            </button>
        </div>
    }
    else
    {
        @* Nada de projeção aqui. Sem lançamento nenhum o menor saldo é só o saldo de partida
           menos o diário vezes 730 dias: um número assustador que não diz nada. A projeção
           aparece na tela Hoje, onde o número tem contexto. *@
        <Grupo>
            <ul class="lista">
                <li>
                    <div class="item">
                        <span class="item-principal">
                            <span class="item-titulo">Seus números</span>
                            <span class="item-sub">Saldo, gasto diário e conforto</span>
                        </span>
                        <span class="farol ok"><Icone Nome="check" Tamanho="14" /> feito</span>
                    </div>
                </li>
                @foreach (var etapa in Resumo())
                {
                    <li>
                        <div class="item">
                            <span class="item-principal">
                                <span class="item-titulo">@etapa.Titulo</span>
                                <span class="item-sub">@etapa.Detalhe</span>
                            </span>
                            @if (etapa.Quantidade > 0)
                            {
                                <span class="farol ok"><Icone Nome="check" Tamanho="14" /> feito</span>
                            }
                            else
                            {
                                <span class="pilula neutra">pulado</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        </Grupo>

        <p class="dica" style="margin-top:12px">O que ficou para depois dá para cadastrar em Lançar e em Ajustes.</p>

        <div class="acoes">
            <a class="btn largo" href="">Ir para Hoje</a>
        </div>
    }
}

@code {
    private const int PassoNumeros1 = 1;
    private const int PassoNumeros2 = 2;
    private const int PassoNumeros3 = 3;
    private const int PassoEntradas = 4;
    private const int PassoFixas = 5;
    private const int PassoCartoes = 6;
    private const int PassoPronto = 7;
    private const int TotalPassos = 6;

    private Configuracao? _cfg;
    private DadosPlanejamento? _dados;
    private int _passo = PassoNumeros1;
    private bool _salvando;
    private List<string> _erros = [];

    private Lancamento? _novo;
    private Cartao? _novoCartao;
    private List<string> _errosItem = [];
    private string _repeticao = "mensal";
    private string? _confirmacao;

    // Com o formulário aberto, salvar é a ação principal. Dois botões de destaque na mesma
    // tela fazem a pessoa parar para descobrir qual dos dois é o caminho.
    private string ClasseAvancar => _novo is null && _novoCartao is null ? "btn" : "btn contorno";

    private string TituloDoPasso() => _passo switch
    {
        PassoNumeros1 => "Quanto tem na conta?",
        PassoNumeros2 => "Quanto gasta por dia?",
        PassoNumeros3 => "Qual saldo te deixa tranquilo?",
        PassoEntradas => "O que entra na conta",
        PassoFixas => "Contas de todo mês",
        PassoCartoes => "Cartões de crédito",
        _ => "Tudo pronto"
    };

    protected override async Task OnInitializedAsync()
    {
        _cfg = await Servico.ObterConfiguracaoAsync();

        if (_cfg.DataAncora == default)
        {
            _cfg.DataAncora = Relogio.Hoje;
        }

        // Quem já salvou os números e saiu no meio do cadastro volta de onde parou, não do
        // começo: refazer as três primeiras telas para chegar no que falta cansa e não muda nada.
        if (_cfg.ConfiguracaoConcluida)
        {
            await CarregarDadosAsync();
            _passo = PassoEntradas;
            PrepararPasso();
        }
    }

    private async Task CarregarDadosAsync() => _dados = await Servico.CarregarAsync();

    private List<Lancamento> ItensDoPasso() =>
        (_dados?.Lancamentos ?? [])
        .Where(l => l.Tipo == TipoDoPasso())
        .OrderBy(l => l.Data)
        .ToList();

    private TipoLancamento TipoDoPasso() =>
        _passo == PassoEntradas ? TipoLancamento.Entrada : TipoLancamento.Saida;

    private sealed record LinhaResumo(string Titulo, string Detalhe, int Quantidade);

    private List<LinhaResumo> Resumo()
    {
        var lancamentos = _dados?.Lancamentos ?? [];
        var entradas = lancamentos.Count(l => l.Tipo == TipoLancamento.Entrada);
        var saidas = lancamentos.Count(l => l.Tipo == TipoLancamento.Saida);
        var cartoes = _dados?.Cartoes.Count ?? 0;

        return
        [
            new("Entradas", Contagem(entradas, "entrada", "entradas"), entradas),
            new("Contas de todo mês", Contagem(saidas, "conta", "contas"), saidas),
            new("Cartões", Contagem(cartoes, "cartão", "cartões"), cartoes)
        ];
    }

    private static string Contagem(int quantos, string singular, string plural) =>
        quantos == 0 ? "Nada cadastrado" : Formato.Quantos(quantos, singular, plural);

    // Cada acao que grava confere a trava antes de tudo: o disabled do botao so chega ao celular
    // depois de uma ida e volta pela rede, e um toque duplo rapido gravaria duas vezes.
    private async Task SalvarNumerosAsync()
    {
        if (_cfg is null || _salvando)
        {
            return;
        }

        _erros = Validacao.Configuracao(_cfg);

        if (_erros.Count > 0)
        {
            return;
        }

        _salvando = true;

        try
        {
            _cfg.ConfiguracaoConcluida = true;
            await Servico.SalvarConfiguracaoAsync(_cfg, "Primeiro acesso");
            await CarregarDadosAsync();
            _passo = PassoEntradas;
            PrepararPasso();
        }
        finally
        {
            _salvando = false;
        }
    }

    /// <summary>
    /// Entra na etapa com o formulário já aberto quando ela está vazia: a etapa só existe para
    /// cadastrar, então pedir um toque antes do primeiro campo é um toque sem função.
    /// </summary>
    private void PrepararPasso()
    {
        _novo = null;
        _novoCartao = null;
        _errosItem = [];
        _confirmacao = null;

        if (_passo is PassoEntradas or PassoFixas && ItensDoPasso().Count == 0)
        {
            AbrirFormulario();
        }
        else if (_passo == PassoCartoes && (_dados?.Cartoes.Count ?? 0) == 0)
        {
            AbrirFormularioCartao();
        }
    }

    private void AbrirFormulario()
    {
        _errosItem = [];
        _repeticao = "mensal";

        // Vezes = null é "todo mês, sem fim": salário e conta fixa são isso, e é o que a etapa pede.
        _novo = new Lancamento
        {
            Data = Relogio.Hoje,
            Tipo = TipoDoPasso(),
            Vezes = null
        };
    }

    private void AbrirFormularioCartao()
    {
        _errosItem = [];
        _novoCartao = new Cartao { Nome = "", DiaFechamento = 1, DiaVencimento = 10 };
    }

    private void FecharFormulario()
    {
        _novo = null;
        _novoCartao = null;
        _errosItem = [];
    }

    private void TrocarRepeticao(ChangeEventArgs evento) => _repeticao = evento.Value?.ToString() ?? "mensal";

    private async Task SalvarItemAsync()
    {
        if (_novo is null || _dados is null || _salvando)
        {
            return;
        }

        _novo.Tipo = TipoDoPasso();
        _novo.Vezes = _repeticao == "mensal" ? null : 1;
        _novo.Certeza = _novo.Tipo == TipoLancamento.Entrada ? Certeza.Certa : null;

        _errosItem = Validacao.Lancamento(_novo, _dados.Cartoes);

        if (_errosItem.Count > 0)
        {
            return;
        }

        _salvando = true;

        try
        {
            var descricao = _novo.Descricao;
            await Servico.SalvarLancamentoAsync(_novo);
            await CarregarDadosAsync();
            _novo = null;
            _confirmacao = $"{descricao} salvo.";
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task SalvarCartaoAsync()
    {
        if (_novoCartao is null || _salvando)
        {
            return;
        }

        _errosItem = Validacao.Cartao(_novoCartao);

        if (_errosItem.Count > 0)
        {
            return;
        }

        _salvando = true;

        try
        {
            if (await Servico.SalvarCartaoAsync(_novoCartao) is string recusa)
            {
                _errosItem = [recusa];
                return;
            }

            var nome = _novoCartao.Nome;
            await CarregarDadosAsync();
            _novoCartao = null;
            _confirmacao = $"Cartão {nome} salvo.";
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Avancar()
    {
        _passo++;
        PrepararPasso();
    }

    private void Voltar()
    {
        _passo--;
        PrepararPasso();
    }
}
