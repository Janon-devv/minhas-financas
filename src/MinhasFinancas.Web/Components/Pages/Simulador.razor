@page "/simulador"
@inject PlanejamentoService Servico
@inject IRelogio Relogio

<PageTitle>Simulador | Minhas Finanças</PageTitle>

<h1>Cabe uma compra?</h1>
<p class="ajuda" style="margin-top:0.3rem">
    Nada aqui mexe no seu planejamento. É só uma conta de e se.
</p>

@if (_dados is null)
{
    <p class="vazio">Carregando...</p>
}
else
{
    @* No PC o formulario fica a esquerda e o resultado a direita. *@
    <div class="colunas" style="margin-top:0.75rem">

    <div>
    <div class="cartao">
        <div class="campo-grupo">
            <label for="descricao">O que é</label>
            <input id="descricao" class="campo" @bind="_descricao" placeholder="Notebook, geladeira, viagem" />
        </div>

        <div class="linha-campos">
            <div class="campo-grupo">
                <label for="preco">Preço à vista</label>
                <CampoDinheiro Valor="_preco" ValorChanged="v => _preco = v" Id="preco" />
            </div>
            <div class="campo-grupo">
                <label for="entrada">Entrada</label>
                <CampoDinheiro Valor="_entrada" ValorChanged="v => _entrada = v" Id="entrada" />
            </div>
        </div>

        @if (_entrada > 0)
        {
            <div class="campo-grupo">
                <label for="data-entrada">Quando paga a entrada</label>
                <CampoData Valor="_dataEntrada" ValorChanged="v => _dataEntrada = v" Id="data-entrada" />
            </div>
        }

        <div class="linha-campos">
            <div class="campo-grupo">
                <label for="parcelas">Parcelas</label>
                <input id="parcelas" type="number" inputmode="numeric" min="1" max="@MinhasFinancas.Domain.Simulador.MaximoParcelas"
                       class="campo" @bind="_parcelas" />
            </div>
            <div class="campo-grupo">
                <label for="taxa">Juros ao mês (%)</label>
                <CampoDinheiro Valor="_taxaCentesimos" ValorChanged="v => _taxaCentesimos = v" Id="taxa" />
                <div class="dica">Zero se for sem juros.</div>
            </div>
        </div>

        @if (_preco - _entrada > 0)
        {
            <div class="campo-grupo">
                <label for="primeira">Primeira parcela</label>
                <CampoData Valor="_primeiraParcela" ValorChanged="v => _primeiraParcela = v" Id="primeira" />
                <div class="dica">
                    Se for no cartão, use o dia em que a fatura vence, não o da compra.
                </div>
            </div>
        }

        <div class="acoes">
            <button type="button" class="btn largo" @onclick="Simular">Ver se cabe</button>
        </div>
    </div>

    @if (_erros.Count > 0)
    {
        <div class="aviso ruim" role="alert">
            @foreach (var erro in _erros)
            {
                <div>@erro</div>
            }
        </div>
    }
    </div>

    <div>
    @if (_resultado is null)
    {
        <div class="cartao">
            <div class="rotulo">Resultado</div>
            <p class="ajuda" style="margin:0.3rem 0 0">
                Preencha os campos e toque em ver se cabe. O app compara o seu saldo projetado
                com e sem a compra, dia a dia, e diz onde fica o pior dia.
            </p>
        </div>
    }
    else if (_projecao is not null)
    {
        var conforto = _dados.Configuracao.SaldoConfortoCentavos;

        <div class="aviso @Formato.ClasseVeredito(_resultado.Veredito)">
            <strong>@Formato.TextoVeredito(_resultado.Veredito)</strong>
            @if (_resultado.MenorComCentavos is long menorCom)
            {
                <text>
                    O pior dia passa a ser @Formato.Data(_resultado.DataMenorCom!.Value),
                    com @Formato.Moeda(menorCom).
                </text>
            }
        </div>

        @if (_resultado.JaEstavaNegativoSemCompra)
        {
            <div class="aviso atencao">
                O cenário já apresentava saldo negativo antes da compra.
                A compra piora o pior dia em @Formato.Moeda(_resultado.PioraCentavos),
                mas o problema não começa nela.
            </div>
        }

        @if (_resultado.ImpactoParcial)
        {
            <div class="aviso atencao">
                <strong>Impacto parcial.</strong>
                Há pagamentos depois do fim da projeção, somando
                @Formato.Moeda(_resultado.PagamentosForaDoHorizonteCentavos).
                O que você vê aqui é só o pedaço que cabe no horizonte.
            </div>
        }

        <div class="grade2" style="margin-top:0.75rem">
            <div class="cartao">
                <div class="rotulo">Total pago</div>
                <div class="numero medio">@Formato.Moeda(_resultado.TotalPagoCentavos)</div>
                @if (_resultado.JurosTotaisCentavos > 0)
                {
                    <div class="ajuda valor-negativo">
                        @Formato.Moeda(_resultado.JurosTotaisCentavos) só de juros
                    </div>
                }
                else
                {
                    <div class="ajuda">Sem juros</div>
                }
            </div>
            <div class="cartao">
                <div class="rotulo">Folga no conforto</div>
                <div class="numero medio @((_resultado.FolgaCentavos ?? 0) < 0 ? "valor-negativo" : "valor-ok")">
                    @Formato.Moeda(_resultado.FolgaCentavos)
                </div>
                <div class="ajuda">
                    @if (_resultado.PrimeiroDiaAbaixoConfortoCom is DateOnly abaixo)
                    {
                        <text>Abaixo do conforto a partir de @Formato.Data(abaixo)</text>
                    }
                    else
                    {
                        <text>Nunca fica abaixo do conforto</text>
                    }
                </div>
            </div>
        </div>

        <div class="bloco" style="margin-top:0.75rem">
            <header><h2>Antes e depois</h2></header>
            <table class="tabela">
                <tbody>
                    <tr>
                        <td>Pior dia sem a compra</td>
                        <td class="num @Formato.ClasseValor(_resultado.MenorSemCentavos ?? 0, conforto)">
                            @Formato.Moeda(_resultado.MenorSemCentavos)
                            <div class="ajuda">@Formato.Data(_resultado.DataMenorSem)</div>
                        </td>
                    </tr>
                    <tr>
                        <td>Pior dia com a compra</td>
                        <td class="num @Formato.ClasseValor(_resultado.MenorComCentavos ?? 0, conforto)">
                            @Formato.Moeda(_resultado.MenorComCentavos)
                            <div class="ajuda">@Formato.Data(_resultado.DataMenorCom)</div>
                        </td>
                    </tr>
                    <tr>
                        <td>Quanto piora</td>
                        <td class="num">@Formato.Moeda(_resultado.PioraCentavos)</td>
                    </tr>
                </tbody>
            </table>
            <div class="corpo">
                <GraficoSaldo Serie="_serieSem" SerieComparacao="_serieCom" Conforto="conforto" />
            </div>
        </div>

        @if (_resultado.Parcelas.Count > 0)
        {
            <div class="bloco rolagem" style="margin-top:0.75rem">
                <header><h2>Cronograma</h2></header>
                <table class="tabela">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Vence</th>
                            <th class="num">Parcela</th>
                            @if (_resultado.JurosTotaisCentavos > 0)
                            {
                                <th class="num">Juros</th>
                                <th class="num">Resta</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (_resultado.EntradaCentavos > 0)
                        {
                            <tr>
                                <td>entrada</td>
                                <td>@Formato.Data(_resultado.DataEntrada)</td>
                                <td class="num">@Formato.Numero(_resultado.EntradaCentavos)</td>
                                @if (_resultado.JurosTotaisCentavos > 0)
                                {
                                    <td class="num">0,00</td>
                                    <td class="num"></td>
                                }
                            </tr>
                        }
                        @foreach (var parcela in _resultado.Parcelas)
                        {
                            <tr>
                                <td>@parcela.Numero</td>
                                <td>@Formato.Data(parcela.Data)</td>
                                <td class="num">@Formato.Numero(parcela.PagamentoCentavos)</td>
                                @if (_resultado.JurosTotaisCentavos > 0)
                                {
                                    <td class="num">@Formato.Numero(parcela.JurosCentavos)</td>
                                    <td class="num">@Formato.Numero(parcela.SaldoDevedorCentavos)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="ajuda" style="margin-top:0.5rem">
            A conta não inclui seguro, tarifas, IOF nem juros por dia corrido, então não é o custo
            efetivo total que o banco informa.
        </p>
    }
    </div>

    </div>
}

@code {
    private DadosPlanejamento? _dados;
    private ResultadoProjecao? _projecao;
    private ResultadoSimulacao? _resultado;
    private List<string> _erros = [];
    private List<PontoGrafico> _serieSem = [];
    private List<PontoGrafico> _serieCom = [];

    private string _descricao = "";
    private long _preco;
    private long _entrada;
    private long _taxaCentesimos;
    private int _parcelas = 1;
    private DateOnly? _dataEntrada;
    private DateOnly? _primeiraParcela;

    protected override async Task OnInitializedAsync()
    {
        _dados = await Servico.CarregarAsync();
        _dataEntrada = Relogio.Hoje;
        _primeiraParcela = MinhasFinancas.Domain.Calendario.AdicionarMeses(Relogio.Hoje, 1);
    }

    private void Simular()
    {
        if (_dados is null)
        {
            return;
        }

        var simulacao = new Simulacao
        {
            Descricao = _descricao,
            ValorTotalCentavos = _preco,
            EntradaCentavos = _entrada,
            Parcelas = Math.Max(1, _parcelas),
            // O campo recebe a taxa em por cento com duas casas: 1,99 chega como 199.
            TaxaMensal = _taxaCentesimos / 10_000m,
            DataEntrada = _entrada > 0 ? _dataEntrada : null,
            PrimeiraParcela = _primeiraParcela ?? Relogio.Hoje
        };

        _erros = Validacao.Simulacao(simulacao, Relogio.Hoje);

        if (_erros.Count > 0)
        {
            _resultado = null;
            return;
        }

        _projecao = Servico.Projetar(_dados, simulacao, Relogio.Hoje);
        _resultado = _projecao.Simulacao;
        MontarSeries();
    }

    private void MontarSeries()
    {
        _serieSem = [];
        _serieCom = [];

        if (_projecao is null || _resultado is null)
        {
            return;
        }

        // Mostra de hoje ate dois meses depois do ultimo pagamento: e onde a compra pesa.
        var ultimoPagamento = _resultado.Parcelas.Count > 0
            ? _resultado.Parcelas[^1].Data
            : _resultado.DataEntrada ?? Relogio.Hoje;

        var fimJanela = MinhasFinancas.Domain.Calendario.Menor(
            MinhasFinancas.Domain.Calendario.AdicionarMeses(ultimoPagamento, 2),
            _projecao.Fim);

        var inicioJanela = MinhasFinancas.Domain.Calendario.Maior(Relogio.Hoje, _projecao.Inicio);

        foreach (var dia in _projecao.Dias.Where(d => d.Data >= inicioJanela && d.Data <= fimJanela))
        {
            _serieSem.Add(new PontoGrafico(dia.Data, dia.SaldoCentavos));

            if (_resultado.SaldosComCompra.TryGetValue(dia.Data, out var comCompra))
            {
                _serieCom.Add(new PontoGrafico(dia.Data, comCompra));
            }
        }
    }
}
