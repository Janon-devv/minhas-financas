@page "/simulador"
@inject PlanejamentoService Servico
@inject IRelogio Relogio

<PageTitle>Simular compra | Minhas Finanças</PageTitle>

<Cabecalho Titulo="Simular compra" Voltar="" />

@if (_dados is null)
{
    <Carregando />
}
else
{
    @* No PC o formulário fica à esquerda e o resultado à direita. *@
    <div class="colunas">
        <div>
            <Grupo Classe="sem-titulo">
                <div class="corpo">
                    <p class="dica" style="margin:0 0 16px">Só uma conta. Não muda seus lançamentos.</p>

                    <div class="campo-grupo">
                        <Rotulo Texto="O que é (opcional)" Para="descricao" />
                        <input id="descricao" class="campo" @bind="_descricao" autocomplete="off" placeholder="Notebook" />
                    </div>

                    <div class="linha-campos">
                        <div class="campo-grupo">
                            <Rotulo Texto="Preço à vista" Para="preco" />
                            <CampoDinheiro Valor="_preco" ValorChanged="v => _preco = v" Id="preco" />
                        </div>
                        <div class="campo-grupo">
                            <Rotulo Texto="Entrada" Para="entrada" />
                            <CampoDinheiro Valor="_entrada" ValorChanged="v => _entrada = v" Id="entrada" />
                        </div>
                    </div>

                    @if (_entrada > 0)
                    {
                        <div class="campo-grupo">
                            <Rotulo Texto="Data da entrada" Para="data-entrada" />
                            <CampoData Valor="_dataEntrada" ValorChanged="v => _dataEntrada = v" Id="data-entrada" />
                        </div>
                    }

                    <div class="linha-campos">
                        <div class="campo-grupo">
                            <Rotulo Texto="Parcelas" Para="parcelas" />
                            <input id="parcelas" type="number" inputmode="numeric" min="1" max="@MinhasFinancas.Domain.Simulador.MaximoParcelas"
                                   class="campo" @bind="_parcelas" />
                        </div>
                        <div class="campo-grupo">
                            <Rotulo Texto="Juros ao mês" Para="taxa" Ajuda="Deixe zero se for sem juros." />
                            <CampoDinheiro Valor="_taxaCentesimos" ValorChanged="v => _taxaCentesimos = v" Id="taxa"
                                           Prefixo="@null" Sufixo="%" />
                        </div>
                    </div>

                    @if (_preco - _entrada > 0)
                    {
                        <div class="campo-grupo">
                            <Rotulo Texto="Primeira parcela" Para="primeira"
                                    Ajuda="No cartão, use o dia em que a fatura vence, não o da compra." />
                            <CampoData Valor="_primeiraParcela" ValorChanged="v => _primeiraParcela = v" Id="primeira" />
                        </div>
                    }

                    @if (_erros.Count > 0)
                    {
                        <Aviso Tipo="ruim" Papel="alert">
                            @foreach (var erro in _erros)
                            {
                                <div>@erro</div>
                            }
                        </Aviso>
                    }

                    <div class="acoes">
                        <button type="button" class="btn largo" @onclick="Simular">Simular</button>
                    </div>
                </div>
            </Grupo>
        </div>

        <div>
            @if (_resultado is null)
            {
                <Grupo Classe="sem-titulo">
                    <Vazio Texto="O resultado compara seu saldo previsto com e sem a compra." NomeIcone="simulador" />
                </Grupo>
            }
            else if (_projecao is not null)
            {
                var conforto = _dados.Configuracao.SaldoConfortoCentavos;

                <div class="grupo sem-titulo" id="resultado">
                    <Aviso Tipo="@Formato.ClasseVeredito(_resultado.Veredito)" Papel="status">
                        <strong>@Formato.TextoVeredito(_resultado.Veredito).</strong>
                        @if (_resultado.MenorComCentavos is long menorCom)
                        {
                            <text>
                                Com a compra, o menor saldo vai a @Formato.Moeda(menorCom)
                                em @Formato.Data(_resultado.DataMenorCom!.Value).
                            </text>
                        }
                    </Aviso>

                    @if (_resultado.JaEstavaNegativoSemCompra)
                    {
                        <Aviso Tipo="atencao">
                            O saldo já ficava negativo sem a compra. Ela piora o menor saldo em
                            @Formato.Moeda(_resultado.PioraCentavos), mas o aperto não começa nela.
                        </Aviso>
                    }

                    @if (_resultado.ImpactoParcial)
                    {
                        <Aviso Tipo="atencao">
                            <strong>Impacto parcial.</strong>
                            @Formato.Moeda(_resultado.PagamentosForaDoHorizonteCentavos) em pagamentos ficam depois do
                            fim da previsão e não aparecem aqui.
                        </Aviso>
                    }
                </div>

                <Grupo Titulo="Antes e depois">
                    <div class="corpo">
                        <dl class="indicadores" style="grid-template-columns:1fr 1fr">
                            <div>
                                <dt>Menor saldo sem</dt>
                                <dd>
                                    <Valor Centavos="_resultado.MenorSemCentavos" Classe="@Formato.ClasseValor(_resultado.MenorSemCentavos ?? 0, conforto)" />
                                    <span class="indicador-sub">@Formato.Data(_resultado.DataMenorSem)</span>
                                </dd>
                            </div>
                            <div>
                                <dt>Menor saldo com</dt>
                                <dd>
                                    <Valor Centavos="_resultado.MenorComCentavos" Classe="@Formato.ClasseValor(_resultado.MenorComCentavos ?? 0, conforto)" />
                                    <span class="indicador-sub">@Formato.Data(_resultado.DataMenorCom)</span>
                                    @if (_resultado.PioraCentavos > 0)
                                    {
                                        <span class="indicador-sub">piora @Formato.Moeda(_resultado.PioraCentavos)</span>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt>Folga no conforto</dt>
                                <dd>
                                    <Valor Centavos="_resultado.FolgaCentavos" Classe="@((_resultado.FolgaCentavos ?? 0) < 0 ? "valor-negativo" : null)" />
                                    <span class="indicador-sub">
                                        @(_resultado.PrimeiroDiaAbaixoConfortoCom is DateOnly abaixo
                                            ? $"abaixo a partir de {Formato.Data(abaixo)}"
                                            : "nunca abaixo do conforto")
                                    </span>
                                </dd>
                            </div>
                            <div>
                                <dt>Total pago</dt>
                                <dd>
                                    <Valor Centavos="_resultado.TotalPagoCentavos" />
                                    <span class="indicador-sub">
                                        @(_resultado.JurosTotaisCentavos > 0
                                            ? $"{Formato.Moeda(_resultado.JurosTotaisCentavos)} de juros"
                                            : "sem juros")
                                    </span>
                                </dd>
                            </div>
                        </dl>

                        <div style="margin-top:20px">
                            <GraficoSaldo Serie="_serieSem" SerieComparacao="_serieCom" Conforto="conforto" />
                        </div>
                    </div>
                </Grupo>

                @if (_resultado.Parcelas.Count > 0)
                {
                    <Grupo>
                        <details class="detalhes">
                            <summary>
                                Parcelas (@(_resultado.Parcelas.Count + (_resultado.EntradaCentavos > 0 ? 1 : 0)))
                                <Icone Nome="abrir" Tamanho="18" />
                            </summary>
                            <ul class="lista">
                                @if (_resultado.EntradaCentavos > 0)
                                {
                                    <li>
                                        <div class="item" style="min-height:52px">
                                            <span class="item-principal">
                                                <span class="item-titulo">Entrada</span>
                                                <span class="item-sub">@Formato.Data(_resultado.DataEntrada)</span>
                                            </span>
                                            <span class="item-valor"><Valor Centavos="_resultado.EntradaCentavos" /></span>
                                        </div>
                                    </li>
                                }
                                @foreach (var parcela in _resultado.Parcelas)
                                {
                                    <li>
                                        <div class="item" style="min-height:52px">
                                            <span class="item-principal">
                                                <span class="item-titulo">Parcela @parcela.Numero</span>
                                                <span class="item-sub">@Formato.Data(parcela.Data)</span>
                                            </span>
                                            <span class="item-valor">
                                                <Valor Centavos="parcela.PagamentoCentavos" />
                                                @if (_resultado.JurosTotaisCentavos > 0)
                                                {
                                                    <span class="item-valor-sub">
                                                        juros @Formato.Moeda(parcela.JurosCentavos), resta @Formato.Moeda(parcela.SaldoDevedorCentavos)
                                                    </span>
                                                }
                                            </span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </details>
                    </Grupo>
                }

                <p class="dica" style="margin-top:12px">
                    Não inclui seguro, tarifas, IOF nem juros por dia corrido: não é o custo efetivo total do banco.
                </p>
            }
        </div>
    </div>
}

@code {
    private DadosPlanejamento? _dados;
    private ResultadoProjecao? _projecao;
    private ResultadoSimulacao? _resultado;
    private List<string> _erros = [];
    private List<PontoGrafico> _serieSem = [];
    private List<PontoGrafico> _serieCom = [];

    private string _descricao = "";
    private long _preco;
    private long _entrada;
    private long _taxaCentesimos;
    private int _parcelas = 1;
    private DateOnly? _dataEntrada;
    private DateOnly? _primeiraParcela;

    protected override async Task OnInitializedAsync()
    {
        _dados = await Servico.CarregarAsync();
        _dataEntrada = Relogio.Hoje;
        _primeiraParcela = MinhasFinancas.Domain.Calendario.AdicionarMeses(Relogio.Hoje, 1);
    }

    private void Simular()
    {
        if (_dados is null)
        {
            return;
        }

        var simulacao = new Simulacao
        {
            Descricao = _descricao,
            ValorTotalCentavos = _preco,
            EntradaCentavos = _entrada,
            Parcelas = Math.Max(1, _parcelas),
            // O campo recebe a taxa em por cento com duas casas: 1,99 chega como 199.
            TaxaMensal = _taxaCentesimos / 10_000m,
            DataEntrada = _entrada > 0 ? _dataEntrada : null,
            PrimeiraParcela = _primeiraParcela ?? Relogio.Hoje
        };

        _erros = Validacao.Simulacao(simulacao, Relogio.Hoje);

        if (_erros.Count > 0)
        {
            _resultado = null;
            return;
        }

        _projecao = Servico.Projetar(_dados, simulacao, Relogio.Hoje);
        _resultado = _projecao.Simulacao;
        MontarSeries();
    }

    private void MontarSeries()
    {
        _serieSem = [];
        _serieCom = [];

        if (_projecao is null || _resultado is null)
        {
            return;
        }

        // Mostra de hoje ate dois meses depois do ultimo pagamento: e onde a compra pesa.
        var ultimoPagamento = _resultado.Parcelas.Count > 0
            ? _resultado.Parcelas[^1].Data
            : _resultado.DataEntrada ?? Relogio.Hoje;

        var fimJanela = MinhasFinancas.Domain.Calendario.Menor(
            MinhasFinancas.Domain.Calendario.AdicionarMeses(ultimoPagamento, 2),
            _projecao.Fim);

        var inicioJanela = MinhasFinancas.Domain.Calendario.Maior(Relogio.Hoje, _projecao.Inicio);

        foreach (var dia in _projecao.Dias.Where(d => d.Data >= inicioJanela && d.Data <= fimJanela))
        {
            _serieSem.Add(new PontoGrafico(dia.Data, dia.SaldoCentavos));

            if (_resultado.SaldosComCompra.TryGetValue(dia.Data, out var comCompra))
            {
                _serieCom.Add(new PontoGrafico(dia.Data, comCompra));
            }
        }
    }
}
