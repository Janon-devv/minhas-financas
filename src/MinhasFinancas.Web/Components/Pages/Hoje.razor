@page "/"
@inject PlanejamentoService Servico
@inject IRelogio Relogio
@inject NavigationManager Nav

<PageTitle>Hoje | Minhas Finanças</PageTitle>

@if (_dados is null || _projecao is null)
{
    <Cabecalho Titulo="Hoje" Marca="true" Classe="destaque" />
    <Carregando />
}
else
{
    var agora = _projecao.Agora;
    var cfg = _dados.Configuracao;
    var conforto = cfg.SaldoConfortoCentavos;
    var aVencer = ContasAVencer();
    var conferidoHoje = cfg.DataAncora == Relogio.Hoje.AddDays(1);
    var semResposta = _pendencias.Count(p => p.ForaDaProjecao && !p.Registrada);

    <Cabecalho Titulo="@($"Hoje, {Formato.DataExtensa(Relogio.Hoje)}")" Marca="true" Classe="destaque com-acoes">
        <div class="hero">
            <div class="rotulo-linha hero-rotulo">
                <span class="rotulo-texto">@(conferidoHoje ? "Saldo de hoje" : "Saldo previsto hoje")</span>
                <BotaoAjuda Rotulo="Como ler estes números" Controla="ajuda-hero" Aberta="_ajudaHero"
                            AoAlternar="@(() => _ajudaHero = !_ajudaHero)" />
            </div>

            @if (agora.SaldoHojeCentavos is long saldoHoje)
            {
                <Valor Centavos="saldoHoje" Classe="@($"valor-hero {Formato.ClasseValor(saldoHoje, conforto)}")" />
                @if (conferidoHoje)
                {
                    <p class="hero-nota">Conferido com o banco hoje.</p>
                }
            }
            else
            {
                <span class="valor-hero">Sem saldo</span>
                <p class="hero-nota">O saldo começa em @Formato.Data(cfg.DataAncora).</p>
            }
        </div>

        <dl class="hero-indicadores">
            <div class="hero-indicador">
                <dt>Pode gastar hoje</dt>
                <dd><Valor Centavos="agora.PodeGastarHojeCentavos" /></dd>
            </div>
            <div class="hero-indicador">
                <dt>Menor saldo</dt>
                <dd>
                    @if (agora.MenorSaldoAFrenteCentavos is long menor)
                    {
                        <Valor Centavos="menor" Classe="@Formato.ClasseValor(menor, conforto)" />
                        <span class="indicador-sub">em @Formato.DataCurta(agora.DataMenorSaldoAFrente!.Value)</span>
                    }
                    else
                    {
                        <Valor Centavos="null" />
                    }
                </dd>
            </div>
            @if (aVencer.Count > 0 && agora.SaldoHojeCentavos is long saldoBase)
            {
                @* O saldo grande ainda não viu as contas que vencem depois de hoje. Este número
                   é o que sobra se todas elas saírem. *@
                var comprometido = aVencer.Sum(p => p.ValorCentavos);

                <div class="hero-indicador">
                    <dt>Após as contas</dt>
                    <dd>
                        <Valor Centavos="saldoBase - comprometido" Classe="@Formato.ClasseValor(saldoBase - comprometido, conforto)" />
                        <span class="indicador-sub">@Formato.Quantos(aVencer.Count, "conta", "contas")</span>
                    </dd>
                </div>
            }
        </dl>

        @if (_ajudaHero)
        {
            <dl class="texto-ajuda ajuda-indicadores" id="ajuda-hero">
                @foreach (var (termo, explicacao) in AjudaDosIndicadores(aVencer, conferidoHoje))
                {
                    <div>
                        <dt>@termo</dt>
                        <dd>@explicacao</dd>
                    </div>
                }
            </dl>
        }
    </Cabecalho>

    <nav class="acoes-rapidas" aria-label="Ações rápidas">
        <a class="acao-rapida" href="ajustes#conferir">
            <span class="acao-rapida-icone"><Icone Nome="banco" Tamanho="20" /></span>
            Conferir saldo
        </a>
        <a class="acao-rapida" href="simulador">
            <span class="acao-rapida-icone"><Icone Nome="simulador" Tamanho="20" /></span>
            Simular compra
        </a>
        <a class="acao-rapida" href="metas">
            <span class="acao-rapida-icone"><Icone Nome="meta" Tamanho="20" /></span>
            Metas
        </a>
    </nav>

    @* ---------- Um aviso por vez, o mais grave ---------- *@
    <div class="avisos">
        @if (_dados.Lancamentos.Count == 0)
        {
            <Aviso Tipo="info">
                <strong>Nenhum lançamento cadastrado.</strong>
                @(cfg.DiarioPrevistoAtivo
                    ? "Por enquanto, o saldo previsto só desconta o gasto diário."
                    : "Por enquanto, o saldo previsto não muda.")
                <div class="acoes inicio">
                    <a class="btn pequeno" href="lancamentos?novo=1">Adicionar</a>
                </div>
            </Aviso>
        }
        else if (agora.MenorSaldoAFrenteCentavos is long pior && pior < 0)
        {
            <Aviso Tipo="ruim">
                <strong>Saldo negativo à frente.</strong>
                Em @Formato.Data(agora.DataMenorSaldoAFrente!.Value) a previsão chega a @Formato.Moeda(pior).
            </Aviso>
        }
        else if (agora.PrimeiroDiaAbaixoConforto is DateOnly aperto)
        {
            <Aviso Tipo="atencao">
                <strong>Abaixo do conforto a partir de @Formato.Data(aperto).</strong>
                Seu conforto é de @Formato.Moeda(conforto).
            </Aviso>
        }
        else if (conforto > 0 && semResposta == 0 && _projecao.Avisos.Count == 0)
        {
            @* Só afirma que está tudo acima do conforto quando nada está fora da conta: conta
               vencida sem resposta ou cadastro com problema deixam a previsão incompleta. *@
            <Aviso Tipo="bom">Acima do conforto até @Formato.Data(_projecao.Fim).</Aviso>
        }

        @foreach (var aviso in _projecao.Avisos)
        {
            <Aviso Tipo="atencao">@aviso</Aviso>
        }
    </div>

    @* No PC as listas ficam em duas colunas; no celular, uma embaixo da outra. *@
    <div class="colunas">
        <div>
            @* ---------- Gasto de hoje ---------- *@
            <Grupo Titulo="Gasto de hoje" Id="gasto-hoje">
                <Marcador>
                    @if (_diarios.All(d => d.Registrado))
                    {
                        <span class="pilula diario">registrado</span>
                    }
                </Marcador>
                <ChildContent>
                    <div class="corpo">
                        @for (var i = 0; i < _diarios.Count; i++)
                        {
                            var linha = _diarios[i];
                            var id = $"diario-{linha.CarteiraId?.ToString() ?? "conta"}";

                            <div class="campo-grupo">
                                <Rotulo Texto="@(_diarios.Count > 1 ? linha.Nome : "Total do dia")" Para="@id"
                                        Ajuda="@(i == 0 ? AjudaGastoDoDia : null)" />
                                <div class="linha-campo-botao">
                                    <CampoDinheiro Valor="linha.Valor" ValorChanged="v => linha.Valor = v" Id="@id" />
                                    <button type="button" class="btn" disabled="@_salvandoDiario"
                                            @onclick="() => SalvarDiario(linha)">Salvar</button>
                                </div>
                                <div class="dica" style="display:flex; align-items:center; justify-content:space-between; gap:8px">
                                    <span>@DicaDoDiario(linha)</span>
                                    @if (linha.Registrado)
                                    {
                                        <button type="button" class="btn texto pequeno" disabled="@_salvandoDiario"
                                                @onclick="() => VoltarParaPrevisao(linha)">
                                            Usar previsto
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (_mensagemDiario is not null)
                        {
                            <Aviso Tipo="bom" Papel="status">@_mensagemDiario</Aviso>
                        }
                    </div>
                </ChildContent>
            </Grupo>

            @* ---------- Contas do mês (R12) ---------- *@
            @if (_pendencias.Count > 0)
            {
                // Conta só o que já venceu: o que ainda vai vencer aparece na lista para poder
                // ser marcado adiantado, mas não é cobrança.
                var aConfirmar = _pendencias.Count(p =>
                    p.Estado is EstadoOcorrencia.EmAberto or EstadoOcorrencia.VenceHoje);
                var abertas = _pendencias.Where(p => p.Estado is not (EstadoOcorrencia.Paga or EstadoOcorrencia.Pulada)).ToList();
                var resolvidas = _pendencias.Where(p => p.Estado is EstadoOcorrencia.Paga or EstadoOcorrencia.Pulada).ToList();

                <Grupo Titulo="Contas do mês">
                    <Marcador>
                        @if (aConfirmar > 0)
                        {
                            <span class="contador alerta" aria-label="@aConfirmar a confirmar">@aConfirmar</span>
                        }
                        else
                        {
                            <span class="pilula entrada">em dia</span>
                        }
                    </Marcador>
                    <ChildContent>
                        @if (semResposta > 0)
                        {
                            @* Este é o caso que mente no saldo: a conta venceu antes do saldo inicial,
                               o dinheiro dela ainda está no extrato que virou o saldo de partida, e a
                               previsão não a mostra saindo. *@
                            <div class="corpo">
                                <Aviso Tipo="atencao" Papel="alert">
                                    <strong>
                                        @(semResposta == 1
                                            ? "1 conta venceu antes do saldo inicial."
                                            : $"{semResposta} contas venceram antes do saldo inicial.")
                                    </strong>
                                    Até você confirmar, @(semResposta == 1 ? "ela fica" : "elas ficam") fora da previsão.
                                </Aviso>
                            </div>
                        }

                        @if (abertas.Count > 0)
                        {
                            <ul class="lista">
                                @foreach (var pendencia in abertas)
                                {
                                    <li>@LinhaPendencia(pendencia)</li>
                                }
                            </ul>
                        }

                        @if (resolvidas.Count > 0)
                        {
                            <details class="detalhes">
                                <summary>
                                    Resolvidas (@resolvidas.Count)
                                    <Icone Nome="abrir" Tamanho="18" />
                                </summary>
                                <ul class="lista">
                                    @foreach (var pendencia in resolvidas)
                                    {
                                        <li>@LinhaPendencia(pendencia)</li>
                                    }
                                </ul>
                            </details>
                        }

                        @if (_mensagemPendencia is not null)
                        {
                            <div class="corpo">
                                <Aviso Tipo="bom" Papel="status">@_mensagemPendencia</Aviso>
                            </div>
                        }
                    </ChildContent>
                </Grupo>
            }
        </div>

        <div>
            @* ---------- Outros saldos ---------- *@
            @* Benefício não paga aluguel: cada carteira tem saldo e conforto próprios, separados
               do número grande, que é só da conta corrente. *@
            <Grupo Titulo="Outros saldos">
                <ul class="lista">
                    @foreach (var carteira in _projecao.Carteiras)
                    {
                        <li>
                            <div class="item">
                                <span class="icone-tipo neutro"><Icone Nome="carteira" Tamanho="20" /></span>
                                <span class="item-principal">
                                    <span class="item-titulo">@carteira.Carteira.Nome</span>
                                    <span class="item-sub">
                                        @if (carteira.Agora.SaldoHojeCentavos is not null)
                                        {
                                            @* O farol é do menor saldo à frente, por isso vem depois dele. *@
                                            @if (carteira.Agora.MenorSaldoAFrenteCentavos is long menorCarteira &&
                                                 menorCarteira != carteira.Agora.SaldoHojeCentavos)
                                            {
                                                <span>menor @Formato.Moeda(menorCarteira)</span>
                                            }
                                            <FarolTag Farol="carteira.Agora.Farol" />
                                        }
                                        else
                                        {
                                            <span>a partir de @Formato.Data(carteira.Carteira.DataAncora)</span>
                                        }
                                    </span>
                                </span>
                                <span class="item-valor">
                                    <Valor Centavos="carteira.Agora.SaldoHojeCentavos" Vazio="sem saldo"
                                           Classe="@(carteira.Agora.SaldoHojeCentavos is long s ? Formato.ClasseValor(s, carteira.Carteira.SaldoConfortoCentavos) : null)" />
                                </span>
                            </div>
                        </li>
                    }
                    <li>
                        <a class="item" href="metas">
                            <span class="icone-tipo economia"><Icone Nome="economia" Tamanho="20" /></span>
                            <span class="item-principal">
                                <span class="item-titulo">Guardado até hoje</span>
                                <span class="item-sub">Metas e economias</span>
                            </span>
                            <span class="item-valor"><Valor Centavos="agora.GuardadoAteHojeCentavos" /></span>
                            <span class="item-seta"><Icone Nome="seta" Tamanho="18" /></span>
                        </a>
                    </li>
                </ul>
            </Grupo>

            @* ---------- Próximos 7 dias ---------- *@
            @{
                var limite = Relogio.Hoje.AddDays(6);
                var proximos = _projecao.Dias
                    .Where(d => d.Data >= Relogio.Hoje && d.Data <= limite && d.TemMovimento)
                    .SelectMany(d => d.Movimentos.Select(m => (d.Data, Movimento: m)))
                    .ToList();
            }

            <Grupo Titulo="Próximos 7 dias">
                <Acoes>
                    <a class="btn texto pequeno" href="calendario">Calendário</a>
                </Acoes>
                <ChildContent>
                    @if (proximos.Count == 0)
                    {
                        <Vazio Texto="Nenhum lançamento nos próximos 7 dias." />
                    }
                    else
                    {
                        <ul class="lista">
                            @foreach (var (data, movimento) in proximos)
                            {
                                var entra = movimento.Tipo == TipoLancamento.Entrada;

                                <li>
                                    <div class="item">
                                        <IconeTipo Tipo="movimento.Tipo" />
                                        <span class="item-principal">
                                            <span class="item-titulo">@movimento.Descricao</span>
                                            <span class="item-sub">
                                                @Formato.Quando(data, Relogio.Hoje)@(Formato.QuandoRelativo(data, Relogio.Hoje) is null ? "" : $", {Formato.DataCurta(data)}")
                                            </span>
                                        </span>
                                        <span class="item-valor">
                                            <Valor Centavos="@(entra ? movimento.ValorCentavos : -movimento.ValorCentavos)"
                                                   Mais="entra" Classe="@(entra ? "valor-entrada" : null)" />
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </ChildContent>
            </Grupo>
        </div>
    </div>
}

@if (_pendenciaAberta is Pendencia aberta && _dados is not null)
{
    var entrada = aberta.Tipo == TipoLancamento.Entrada;
    var pedeValor = PedeValor(aberta);
    var resolvida = aberta.Estado is EstadoOcorrencia.Paga or EstadoOcorrencia.Pulada;

    <Modal Titulo="@aberta.Descricao" AoFechar="FecharPendencia">
        <ChildContent>
            <dl class="linhas">
                <div class="linha">
                    <dt>@(entrada ? "Previsto para" : "Vencimento")</dt>
                    <dd>@Formato.Data(aberta.DataPrevista)</dd>
                </div>
                <div class="linha">
                    <dt>Valor</dt>
                    <dd><Valor Centavos="aberta.ValorCentavos" /></dd>
                </div>
                <div class="linha">
                    <dt>Situação</dt>
                    <dd>@{ var (texto, classe) = Estado(aberta); }<span class="@classe">@texto</span></dd>
                </div>
            </dl>

            @if (aberta.ForaDaProjecao && !aberta.Registrada)
            {
                <p class="dica" style="margin-top:12px">
                    Venceu antes do saldo inicial (@Formato.Data(_dados.Configuracao.DataAncora)).
                    Se já @(entrada ? "caiu" : "saiu"), já está nesse saldo. Se não, entra na previsão
                    como @(entrada ? "valor a receber" : "conta a pagar").
                </p>
            }

            @if (!resolvida && pedeValor)
            {
                <div class="campo-grupo" style="margin-top:16px">
                    <Rotulo Texto="@(entrada ? "Valor recebido" : "Valor pago")" Para="valor-pendencia"
                            Ajuda="Se a conta variou, informe o valor real. Vale só para esta vez; os próximos meses continuam com o valor do lançamento." />
                    <CampoDinheiro Valor="_valorPago" ValorChanged="v => _valorPago = v" Id="valor-pendencia" />
                </div>
            }
        </ChildContent>
        <Rodape>
            @if (resolvida)
            {
                <button type="button" class="btn secundario" disabled="@_salvandoPendencia"
                        @onclick="() => LimparAsync(aberta)">Desfazer</button>
            }
            else
            {
                <button type="button" class="btn" disabled="@_salvandoPendencia"
                        @onclick="() => ConfirmarPagamentoAsync(aberta, pedeValor)">
                    @RotuloDoPagar(aberta)
                </button>
                @if (!aberta.Registrada && aberta.ForaDaProjecao)
                {
                    <button type="button" class="btn secundario" disabled="@_salvandoPendencia"
                            @onclick="() => NaoPagueiAsync(aberta)">Ainda não</button>
                }
                <button type="button" class="btn contorno" disabled="@_salvandoPendencia"
                        @onclick="() => PularAsync(aberta)">Não teve</button>
            }
        </Rodape>
    </Modal>
}

@code {
    private DadosPlanejamento? _dados;
    private ResultadoProjecao? _projecao;
    private string? _mensagemDiario;
    private bool _salvandoDiario;
    private bool _ajudaHero;

    private const string AjudaGastoDoDia =
        "O total de gastos miúdos do dia: lanche, transporte, mercado de passagem. Salvar troca o " +
        "valor do dia, não soma. Zero também vale. Conta fixa e compra no cartão vão em Lançar.";

    /// <summary>
    /// Uma linha de check-in por carteira que tem diário. Carteira sem diário previsto não
    /// aparece aqui: pedir um número que ela não usa só faria inventar gasto.
    /// </summary>
    private sealed class LinhaDiario
    {
        public int? CarteiraId { get; init; }
        public string Nome { get; init; } = "";
        public long Valor { get; set; }
        public bool Registrado { get; init; }
        public long? Previsto { get; init; }
    }

    private List<LinhaDiario> _diarios = [];
    private List<Pendencia> _pendencias = [];
    private bool _salvandoPendencia;
    private string? _mensagemPendencia;
    private Pendencia? _pendenciaAberta;
    private long _valorPago;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _dados = await Servico.CarregarAsync();

        if (!_dados.Configuracao.ConfiguracaoConcluida)
        {
            Nav.NavigateTo("comecar");
            return;
        }

        _projecao = Servico.Projetar(_dados, null, Relogio.Hoje);
        _pendencias = Servico.ListarPendencias(_dados, Relogio.Hoje);

        _diarios = MontarLinhasDeDiario();
    }

    /// <summary>
    /// O que cada número do cabeçalho quer dizer, num painel só: um (i) por indicador espalharia
    /// ícone de ajuda pela tela inteira e quebraria os rótulos das colunas estreitas.
    /// </summary>
    private IEnumerable<(string Termo, string Explicacao)> AjudaDosIndicadores(List<Pendencia> aVencer, bool conferidoHoje)
    {
        var cfg = _dados!.Configuracao;
        var agora = _projecao!.Agora;

        yield return conferidoHoje
            ? ("Saldo de hoje", "O valor que você conferiu com o banco hoje. Já inclui o que saiu hoje.")
            : agora.SaldoHojeCentavos is null
                ? ("Saldo previsto hoje", "A previsão começa na data do saldo inicial, que ainda não chegou.")
                : ("Saldo previsto hoje", cfg.DiarioPrevistoAtivo
                    ? "Previsão para o fim do dia, já descontando o gasto diário previsto."
                    : "Previsão para o fim do dia, com o gasto de hoje que você registrar.");

        yield return ("Pode gastar hoje",
            $"O que sobra acima do seu conforto de {Formato.Moeda(cfg.SaldoConfortoCentavos)} no dia de menor saldo.");

        yield return ("Menor saldo", $"O saldo mais baixo previsto até {Formato.Data(_projecao.Fim)}.");

        if (aVencer.Count > 0)
        {
            yield return ("Após as contas",
                $"Saldo de hoje menos {Formato.Quantos(aVencer.Count, "conta que ainda vence", "contas que ainda vencem")} " +
                $"neste mês ({Formato.Moeda(aVencer.Sum(p => p.ValorCentavos))}). Contas vencidas em aberto já estão no saldo.");
        }
    }

    private string DicaDoDiario(LinhaDiario linha)
    {
        if (linha.Registrado)
        {
            return "Registrado.";
        }

        if (linha.CarteiraId is null && !_dados!.Configuracao.DiarioPrevistoAtivo)
        {
            return "Sem registro, o dia conta zero.";
        }

        return $"Sem registro, conta o previsto de {Formato.Moeda(linha.Previsto ?? 0)}.";
    }

    private List<LinhaDiario> MontarLinhasDeDiario()
    {
        var linhas = new List<LinhaDiario>();
        var registroConta = _dados!.Diarios.FirstOrDefault(d => d.Data == Relogio.Hoje && d.CarteiraId is null);

        linhas.Add(new LinhaDiario
        {
            CarteiraId = null,
            Nome = "Conta corrente",
            Registrado = registroConta is not null,
            Previsto = _dados.Configuracao.DiarioPrevistoCentavos,

            // Com a contagem desligada o campo abre em zero, não no previsto: abrir no previsto
            // convidaria a salvar um gasto que o dono acabou de dizer que não tem.
            Valor = registroConta?.ValorCentavos
                    ?? (_dados.Configuracao.DiarioPrevistoAtivo ? _dados.Configuracao.DiarioPrevistoCentavos : 0)
        });

        foreach (var carteira in _dados.Carteiras.Where(c => c.DiarioPrevistoCentavos is not null))
        {
            var registro = _dados.Diarios.FirstOrDefault(d => d.Data == Relogio.Hoje && d.CarteiraId == carteira.Id);

            linhas.Add(new LinhaDiario
            {
                CarteiraId = carteira.Id,
                Nome = carteira.Nome,
                Registrado = registro is not null,
                Previsto = carteira.DiarioPrevistoCentavos,
                Valor = registro?.ValorCentavos ?? carteira.DiarioPrevistoCentavos ?? 0
            });
        }

        return linhas;
    }

    private async Task SalvarDiario(LinhaDiario linha)
    {
        if (_salvandoDiario)
        {
            return;
        }

        _salvandoDiario = true;

        try
        {
            await Servico.RegistrarDiarioAsync(Relogio.Hoje, linha.Valor, linha.CarteiraId);
            _mensagemDiario = _diarios.Count > 1
                ? $"{linha.Nome}: {Formato.Moeda(linha.Valor)} hoje."
                : $"Salvo: {Formato.Moeda(linha.Valor)} hoje.";
            await CarregarAsync();
        }
        finally
        {
            _salvandoDiario = false;
        }
    }

    private async Task VoltarParaPrevisao(LinhaDiario linha)
    {
        if (_salvandoDiario)
        {
            return;
        }

        _salvandoDiario = true;

        try
        {
            await Servico.VoltarParaPrevisaoAsync(Relogio.Hoje, linha.CarteiraId);
            _mensagemDiario = _diarios.Count > 1
                ? $"{linha.Nome}: hoje voltou para o previsto."
                : "Hoje voltou para o previsto.";
            await CarregarAsync();
        }
        finally
        {
            _salvandoDiario = false;
        }
    }

    // ---------- Contas do mês ----------

    private RenderFragment LinhaPendencia(Pendencia pendencia) => __builder =>
    {
        var (texto, classe) = Estado(pendencia);
        var entra = pendencia.Tipo == TipoLancamento.Entrada;
        var resolvida = pendencia.Estado is EstadoOcorrencia.Paga or EstadoOcorrencia.Pulada;

        <button type="button" class="item @(resolvida ? "apagado" : "")" @onclick="() => AbrirPendencia(pendencia)"
                aria-label="@pendencia.Descricao, @Formato.Data(pendencia.DataPrevista), @Formato.Moeda(pendencia.ValorCentavos), @texto">
            <IconeTipo Tipo="pendencia.Tipo" />
            <span class="item-principal">
                <span class="item-titulo">@pendencia.Descricao</span>
                <span class="item-sub">
                    <span>@Formato.DataCurta(pendencia.DataPrevista)</span>
                    <span class="@classe">@texto</span>
                </span>
            </span>
            <span class="item-valor">
                <Valor Centavos="pendencia.ValorCentavos" Classe="@(entra && !resolvida ? "valor-entrada" : null)" />
            </span>
            <span class="item-seta"><Icone Nome="seta" Tamanho="18" /></span>
        </button>
    };

    /// <summary>O que se sabe da ocorrência, em texto curto, com a classe da pílula.</summary>
    private (string Texto, string Classe) Estado(Pendencia p)
    {
        var entra = p.Tipo == TipoLancamento.Entrada;

        return p switch
        {
            { Estado: EstadoOcorrencia.Pulada } => ("não teve", "pilula neutra"),
            { Estado: EstadoOcorrencia.Paga } =>
                ($"{(entra ? "recebida" : "paga")} em {Formato.DataCurta(p.PagoEm!.Value)}", "farol ok"),
            { Registrada: true } => (entra ? "não recebida" : "não paga", "farol negativo"),
            { ForaDaProjecao: true } => ("confirme", "farol atencao"),
            { Estado: EstadoOcorrencia.VenceHoje } => (entra ? "cai hoje" : "vence hoje", "pilula diario"),
            { Estado: EstadoOcorrencia.Prevista } => (entra ? "a receber" : "a vencer", "pilula neutra"),
            _ => ("a confirmar", "pilula neutra")
        };
    }

    private void AbrirPendencia(Pendencia pendencia)
    {
        _pendenciaAberta = pendencia;
        _valorPago = pendencia.ValorCentavos;
        _mensagemPendencia = null;
    }

    private void FecharPendencia() => _pendenciaAberta = null;

    /// <summary>
    /// Quando o dinheiro saiu, que decide se a saída entra ou não na projeção.
    ///
    /// Ocorrência que venceu antes da âncora e nunca foi respondida: o botão está confirmando que
    /// ela já tinha saído, então a data é a prevista, anterior à âncora, e ela continua fora da
    /// projeção porque o saldo de partida já a contabilizou. Gravar hoje aqui descontaria o mesmo
    /// dinheiro duas vezes.
    ///
    /// Nos outros casos a saída está acontecendo agora: ou o dono já tinha dito que não pagou, ou
    /// a conta vence a partir da âncora. Aí vale hoje, e o atraso fica registrado como a distância
    /// entre as duas datas.
    /// </summary>
    private DateOnly QuandoSaiu(Pendencia pendencia) =>
        !pendencia.Registrada && pendencia.DataPrevista < _dados!.Configuracao.DataAncora
            ? pendencia.DataPrevista
            : Relogio.Hoje;

    /// <summary>
    /// Conta que já saiu antes da âncora não precisa de valor: ela fica fora da projeção de
    /// qualquer jeito, e pedir um número que não muda nada só atrasa a confirmação.
    /// </summary>
    private bool PedeValor(Pendencia pendencia) =>
        !(QuandoSaiu(pendencia) == pendencia.DataPrevista && pendencia.DataPrevista != Relogio.Hoje);

    private string RotuloDoPagar(Pendencia pendencia)
    {
        var entrada = pendencia.Tipo == TipoLancamento.Entrada;

        return PedeValor(pendencia)
            ? (entrada ? "Recebi" : "Paguei")
            : (entrada ? "Já caiu" : "Já saiu");
    }

    private async Task ConfirmarPagamentoAsync(Pendencia pendencia, bool pedirValor)
    {
        var valor = pedirValor ? _valorPago : (long?)null;

        await ComTravaAsync(
            () => Servico.MarcarPagoAsync(pendencia.LancamentoId, pendencia.DataPrevista, QuandoSaiu(pendencia), valor),
            valor is long v && v != pendencia.ValorCentavos
                ? $"{pendencia.Descricao}: confirmado em {Formato.Moeda(v)}."
                : $"{pendencia.Descricao}: confirmado.");
    }

    private async Task PularAsync(Pendencia pendencia) =>
        await ComTravaAsync(
            () => Servico.MarcarPuladaAsync(pendencia.LancamentoId, pendencia.DataPrevista),
            $"{pendencia.Descricao}: não teve desta vez.");

    /// <summary>
    /// As contas que ainda vão sair da conta depois de hoje. Vencidas em aberto ficam de fora
    /// porque já foram trazidas para dentro do saldo projetado, e contá-las aqui seria descontar
    /// duas vezes.
    /// </summary>
    private List<Pendencia> ContasAVencer() =>
        [.. _pendencias.Where(p =>
            p.Tipo != TipoLancamento.Entrada &&
            p.Estado is not (EstadoOcorrencia.Paga or EstadoOcorrencia.Pulada) &&
            p.DataPrevista > Relogio.Hoje)];

    private async Task NaoPagueiAsync(Pendencia pendencia) =>
        await ComTravaAsync(
            () => Servico.MarcarEmAbertoAsync(pendencia.LancamentoId, pendencia.DataPrevista),
            $"{pendencia.Descricao}: entrou na previsão como conta a pagar.");

    private async Task LimparAsync(Pendencia pendencia) =>
        await ComTravaAsync(
            () => Servico.LimparSituacaoAsync(pendencia.LancamentoId, pendencia.DataPrevista),
            $"{pendencia.Descricao}: voltou a ficar sem resposta.");

    /// <summary>Trava os botões enquanto grava: dois toques seguidos gravariam duas vezes.</summary>
    private async Task ComTravaAsync(Func<Task> gravar, string mensagem)
    {
        if (_salvandoPendencia)
        {
            return;
        }

        _salvandoPendencia = true;

        try
        {
            await gravar();
            _mensagemPendencia = mensagem;
            _pendenciaAberta = null;
            await CarregarAsync();
        }
        finally
        {
            _salvandoPendencia = false;
        }
    }
}
