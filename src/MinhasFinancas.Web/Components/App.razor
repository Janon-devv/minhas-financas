<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover libera as areas seguras do iPhone, usadas no topo e na barra de baixo. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#134E4A" />
    <meta name="color-scheme" content="light" />

    <!-- Adicionar a tela de inicio do iPhone abre em tela cheia, sem a barra do Safari. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <!-- Barra de status sobre o cabecalho petroleo, com texto claro. Toda pagina comeca com o
         cabecalho escuro, e a .faixa-status cobre essa area quando o conteudo rola por baixo. -->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Finanças" />
    <link rel="apple-touch-icon" href="icone-180.png" />
    <link rel="icon" href="icone-180.png" />
    <link rel="manifest" href="manifest.json" />

    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MinhasFinancas.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @*
        Com prerender o conteudo ja chega pronto no primeiro HTML, antes de o WebSocket conectar.
        No celular isso e a diferenca entre abrir e ver o saldo ou abrir e ver tela vazia.
    *@
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
