@inject PlanejamentoService Servico
@inject IRelogio Relogio

@* Bloco de faturas (R14 a R16). Mora dentro da tela de lançar, e não numa tela só dele:
   fatura é uma das coisas que o dono lança, e espalhar isso por duas telas obrigava a
   lembrar em qual delas cada número é preenchido. *@

@if (_dados is null)
{
    <p class="vazio">Carregando...</p>
}
else if (_dados.Cartoes.Count == 0)
{
    <div class="bloco" style="margin-top:0.75rem">
        <header>
            <h2>Faturas de cartão</h2>
        </header>
        <div class="corpo">
            <p class="ajuda" style="margin:0">
                Cadastre um cartão em Ajustes primeiro. Sem o dia de fechamento e o de
                vencimento, o app não sabe em que dia a fatura sai da conta.
            </p>
        </div>
    </div>
}
else
{
    <div class="bloco" style="margin-top:0.75rem">
        <header>
            <h2>Faturas de cartão</h2>
            <button type="button" class="btn pequeno" @onclick="() => AbrirFatura(null)">
                <Icone Nome="mais" Tamanho="16" /> Nova
            </button>
        </header>
        <div class="corpo">
            <p class="ajuda" style="margin:0">
                Informe o total que o banco mostra e pronto: a fatura entra como um gasto só, no
                dia do vencimento. Os itens são opcionais, e cada um diz se <strong>detalha</strong>
                o total informado ou se <strong>soma</strong> a ele. Ciclo sem fatura aqui continua
                com cada compra saindo sozinha.
            </p>
        </div>
    </div>

    @if (_resumos.Count == 0)
    {
        <p class="vazio">Nenhuma fatura cadastrada ainda.</p>
    }

    @foreach (var resumo in _resumos)
    {
        <div class="bloco" style="margin-top:0.75rem">
            <header>
                <h2>@resumo.NomeCartao</h2>
                <span class="pilulas">
                    @if (resumo.DevedorCentavos == 0)
                    {
                        <span class="farol ok">paga</span>
                    }
                    else if (resumo.EmAtraso)
                    {
                        <span class="farol negativo">em atraso</span>
                    }
                    else
                    {
                        <span class="pilula neutra">vence @Formato.DataCurta(resumo.Fatura.Vencimento)</span>
                    }
                </span>
            </header>

            <div class="corpo">
                @* A conta aberta, não só o resultado: um total errado sem a decomposição à vista
                   vira desconfiança no app inteiro. *@
                <table class="tabela">
                    <tbody>
                        @if (resumo.TotalFoiInformado)
                        {
                            <tr>
                                <td>Informado</td>
                                <td class="num">@Formato.Moeda(resumo.InformadoCentavos)</td>
                            </tr>
                        }
                        <tr>
                            <td>
                                Acrescentado
                                <div class="ajuda">@resumo.QuantidadeAcrescentada lançamento(s) novo(s)</div>
                            </td>
                            <td class="num">@Formato.Moeda(resumo.AcrescentadoCentavos)</td>
                        </tr>
                        <tr>
                            <td>
                                Detalhado
                                <div class="ajuda">
                                    @resumo.QuantidadeDetalhada item(ns)@(resumo.TotalFoiInformado
                                        ? ", já dentro do informado"
                                        : "")
                                </div>
                            </td>
                            <td class="num">@Formato.Moeda(resumo.DetalhadoCentavos)</td>
                        </tr>
                        <tr>
                            <td><strong>Total efetivo</strong></td>
                            <td class="num"><strong>@Formato.Moeda(resumo.TotalCentavos)</strong></td>
                        </tr>
                        @if (resumo.PagoCentavos > 0)
                        {
                            <tr>
                                <td>
                                    Pago
                                    @if (resumo.Fatura.PagoEm is DateOnly pagoEm)
                                    {
                                        <div class="ajuda">último em @Formato.Data(pagoEm)</div>
                                    }
                                </td>
                                <td class="num valor-ok">@Formato.Moeda(resumo.PagoCentavos)</td>
                            </tr>
                        }
                        @if (resumo.JurosCentavos > 0)
                        {
                            <tr>
                                <td>
                                    Juros do atraso
                                    <div class="ajuda">@resumo.MesesDeAtraso mês(es) de atraso</div>
                                </td>
                                <td class="num valor-negativo">@Formato.Moeda(resumo.JurosCentavos)</td>
                            </tr>
                        }
                        <tr>
                            <td><strong>Falta pagar</strong></td>
                            <td class="num @(resumo.ASairCentavos > 0 ? "valor-negativo" : "valor-ok")">
                                <strong>@Formato.Moeda(resumo.ASairCentavos)</strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p class="ajuda" style="margin:0.5rem 0 0">
                    Fecha em @Formato.Data(resumo.Fatura.Fechamento),
                    vence em @Formato.Data(resumo.Fatura.Vencimento).
                    @if (resumo.ASairCentavos > 0)
                    {
                        <text>Sai da conta em @Formato.Data(MinhasFinancas.Domain.Calendario.Maior(resumo.Fatura.Vencimento, Relogio.Hoje)).</text>
                    }
                </p>

                <div class="acoes">
                    @if (resumo.ASairCentavos > 0)
                    {
                        <button type="button" class="btn pequeno" @onclick="() => AbrirPagamento(resumo)">
                            Registrar pagamento
                        </button>
                    }
                    <button type="button" class="btn pequeno secundario" @onclick="() => AbrirFatura(resumo.Fatura)">
                        Editar
                    </button>
                </div>
            </div>
        </div>
    }
}

@if (_editando is not null)
{
    <Modal Titulo="@(_editando.Id == 0 ? "Nova fatura" : "Editar fatura")" AoFechar="() => _editando = null">
        <div class="campo-grupo">
            <label for="cartao-fatura">Cartão</label>
            <select id="cartao-fatura" class="campo" @bind="_cartaoId" @bind:after="SugerirDatas">
                <option value="0">Escolha o cartão</option>
                @foreach (var cartao in _dados!.Cartoes)
                {
                    <option value="@cartao.Id">@cartao.Nome</option>
                }
            </select>
        </div>

        <div class="linha-campos">
            <div class="campo-grupo">
                <label for="fechamento-fatura">Fecha em</label>
                <CampoData Valor="_editando.Fechamento"
                           ValorChanged="v => _editando.Fechamento = v ?? Relogio.Hoje" Id="fechamento-fatura" />
            </div>
            <div class="campo-grupo">
                <label for="vencimento-fatura">Vence em</label>
                <CampoData Valor="_editando.Vencimento"
                           ValorChanged="v => _editando.Vencimento = v ?? Relogio.Hoje" Id="vencimento-fatura" />
            </div>
        </div>

        <div class="campo-grupo">
            <label class="campo-opcao">
                <input type="checkbox" checked="@(_editando.TotalInformadoCentavos is not null)"
                       @onchange="TrocarTotalInformado" style="width:1.1rem; height:1.1rem" />
                Informar o total que o banco mostra
            </label>
            <div class="dica">
                Desligado, o app soma os itens cadastrados. Ligado, o número que você digitar manda,
                e os itens marcados como detalhamento não são somados de novo.
            </div>
        </div>

        @if (_editando.TotalInformadoCentavos is long total)
        {
            <div class="campo-grupo">
                <label for="total-fatura">Total da fatura</label>
                <CampoDinheiro Valor="total" ValorChanged="v => _editando.TotalInformadoCentavos = v"
                               Id="total-fatura" />
            </div>
        }

        @if (_erros.Count > 0)
        {
            <div class="aviso ruim" role="alert">
                @foreach (var erro in _erros)
                {
                    <div>@erro</div>
                }
            </div>
        }

        <div class="acoes">
            <button type="button" class="btn" @onclick="SalvarFatura" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
            <button type="button" class="btn secundario" @onclick="() => _editando = null">Cancelar</button>
            @if (_editando.Id != 0)
            {
                <button type="button" class="btn perigo" style="margin-left:auto" @onclick="ExcluirFatura">
                    Excluir
                </button>
            }
        </div>
    </Modal>
}

@if (_pagando is not null)
{
    <Modal Titulo="Registrar pagamento" AoFechar="() => _pagando = null">
        <p class="ajuda" style="margin-top:0">
            Falta pagar @Formato.Moeda(_pagando.ASairCentavos) da fatura do @_pagando.NomeCartao.
            Pode pagar menos: o resto continua contando como dívida.
        </p>

        <div class="linha-campos">
            <div class="campo-grupo">
                <label for="valor-pago">Quanto pagou</label>
                <CampoDinheiro Valor="_valorPago" ValorChanged="v => _valorPago = v" Id="valor-pago" />
            </div>
            <div class="campo-grupo">
                <label for="data-pago">Em que dia</label>
                <CampoData Valor="_dataPagamento" ValorChanged="v => _dataPagamento = v ?? Relogio.Hoje" Id="data-pago" />
            </div>
        </div>

        <div class="acoes">
            <button type="button" class="btn" @onclick="ConfirmarPagamento" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Confirmar")
            </button>
            <button type="button" class="btn secundario" @onclick="() => _pagando = null">Cancelar</button>
        </div>
    </Modal>
}

@code {
    /// Os dados já carregados pela tela que hospeda o bloco. Carregar de novo aqui daria duas
    /// projeções por visita e deixaria as duas listas desencontradas depois de salvar.
    [Parameter] public DadosPlanejamento? Dados { get; set; }

    /// Avisa a tela que algo mudou, para ela recarregar tudo de uma vez.
    [Parameter] public EventCallback Mudou { get; set; }

    private DadosPlanejamento? _dados;
    private List<ResumoFatura> _resumos = [];

    private FaturaCartao? _editando;
    private ResumoFatura? _pagando;
    private int _cartaoId;
    private long _valorPago;
    private DateOnly _dataPagamento;
    private List<string> _erros = [];
    private bool _salvando;

    protected override void OnParametersSet()
    {
        _dados = Dados;
        _resumos = _dados is null ? [] : Servico.ResumirFaturas(_dados, Relogio.Hoje);
    }

    private async Task CarregarAsync() => await Mudou.InvokeAsync();

    private void AbrirFatura(FaturaCartao? original)
    {
        _erros = [];

        if (original is null)
        {
            _cartaoId = _dados!.Cartoes.Count == 1 ? _dados.Cartoes[0].Id : 0;
            _editando = new FaturaCartao { Fechamento = Relogio.Hoje, Vencimento = Relogio.Hoje };
            SugerirDatas();
            return;
        }

        _cartaoId = original.CartaoId;

        // Copia, para cancelar não deixar a lista com dados meio editados.
        _editando = new FaturaCartao
        {
            Id = original.Id,
            CartaoId = original.CartaoId,
            Fechamento = original.Fechamento,
            Vencimento = original.Vencimento,
            TotalInformadoCentavos = original.TotalInformadoCentavos,
            PagoCentavos = original.PagoCentavos,
            PagoEm = original.PagoEm,
            Obs = original.Obs
        };
    }

    /// <summary>
    /// Preenche fechamento e vencimento pelos dias do cartão, no ciclo que ainda não venceu.
    /// Continuam editáveis: fatura antiga ou com data trocada pelo banco é caso comum.
    /// </summary>
    private void SugerirDatas()
    {
        if (_editando is null || _editando.Id != 0 ||
            _dados!.Cartoes.FirstOrDefault(c => c.Id == _cartaoId) is not Cartao cartao)
        {
            return;
        }

        var vencimento = MinhasFinancas.Domain.Calendario.NoMes(Relogio.Hoje.Year, Relogio.Hoje.Month, cartao.DiaVencimento);

        if (vencimento < Relogio.Hoje)
        {
            var proximo = Relogio.Hoje.AddMonths(1);
            vencimento = MinhasFinancas.Domain.Calendario.NoMes(proximo.Year, proximo.Month, cartao.DiaVencimento);
        }

        _editando.Vencimento = vencimento;
        _editando.Fechamento = MinhasFinancas.Domain.Calendario.NoMes(vencimento.Year, vencimento.Month, cartao.DiaFechamento);
    }

    private void TrocarTotalInformado(ChangeEventArgs evento)
    {
        if (_editando is not null)
        {
            _editando.TotalInformadoCentavos = evento.Value is true ? 0 : null;
        }
    }

    private async Task SalvarFatura()
    {
        if (_editando is null)
        {
            return;
        }

        _erros = [];

        if (_cartaoId <= 0)
        {
            _erros.Add("Escolha o cartão.");
        }

        if (_editando.Vencimento == default)
        {
            _erros.Add("Informe o vencimento.");
        }

        if (_editando.TotalInformadoCentavos is long total && total < 0)
        {
            _erros.Add("O total da fatura não pode ser negativo.");
        }

        if (_erros.Count > 0)
        {
            return;
        }

        _editando.CartaoId = _cartaoId;
        _salvando = true;

        try
        {
            await Servico.SalvarFaturaAsync(_editando);
            _editando = null;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task ExcluirFatura()
    {
        if (_editando is { Id: > 0 } fatura)
        {
            await Servico.ExcluirFaturaAsync(fatura.Id);
            _editando = null;
            await CarregarAsync();
        }
    }

    private void AbrirPagamento(ResumoFatura resumo)
    {
        _pagando = resumo;
        _valorPago = resumo.ASairCentavos;
        _dataPagamento = Relogio.Hoje;
    }

    private async Task ConfirmarPagamento()
    {
        if (_pagando is null)
        {
            return;
        }

        _salvando = true;

        try
        {
            await Servico.PagarFaturaAsync(_pagando.Fatura.Id, _valorPago, _dataPagamento);
            _pagando = null;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }
}
