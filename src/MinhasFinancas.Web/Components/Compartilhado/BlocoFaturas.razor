@inject PlanejamentoService Servico
@inject IRelogio Relogio

@* Faturas de cartao (R14 a R16). Mora dentro da tela de lancar, e nao numa tela so dela:
   fatura e uma das coisas que o dono lanca, e espalhar isso por duas telas obrigava a
   lembrar em qual delas cada numero e preenchido. *@

@if (_dados is null)
{
    <Carregando />
}
else if (_dados.Cartoes.Count == 0)
{
    <Vazio Texto="Nenhum cartão cadastrado." NomeIcone="cartao">
        <a class="btn" href="ajustes#cartoes">Cadastrar cartão</a>
    </Vazio>
}
else
{
    <div style="margin-top:16px">
        <Rotulo Texto="Uma fatura por ciclo, com o total do banco." Classe="rotulo-dica"
                Ajuda="A fatura entra como um gasto só, no vencimento, e as compras do ciclo deixam de sair uma a uma. Cadastrar as compras é opcional: cada uma diz se já está no total ou se soma a ele. Ciclo sem fatura cadastrada continua com cada compra saindo no vencimento dela." />
    </div>

    @if (_resumos.Count == 0)
    {
        <div class="grupo-corpo" style="margin-top:8px">
            <Vazio Texto="Nenhuma fatura cadastrada.">
                <button type="button" class="btn" @onclick="() => AbrirFatura(null)">Adicionar</button>
            </Vazio>
        </div>
    }

    @foreach (var resumo in _resumos)
    {
        <Grupo Titulo="@resumo.NomeCartao">
            <Marcador>
                @if (resumo.DevedorCentavos == 0)
                {
                    <span class="farol ok">paga</span>
                }
                else if (resumo.EmAtraso)
                {
                    <span class="farol negativo">em atraso</span>
                }
                else
                {
                    <span class="pilula neutra">vence @Formato.DataCurta(resumo.Fatura.Vencimento)</span>
                }
            </Marcador>
            <Acoes>
                <button type="button" class="btn texto pequeno" @onclick="() => AbrirFatura(resumo.Fatura)"
                        aria-label="Editar fatura @resumo.NomeCartao de @Formato.DataCurta(resumo.Fatura.Vencimento)">
                    Editar
                </button>
            </Acoes>
            <ChildContent>
                <div class="corpo">
                    @* A conta aberta, não só o resultado: um total errado sem a decomposição à vista
                       vira desconfiança no app inteiro. *@
                    <dl class="linhas">
                        @if (resumo.TotalFoiInformado)
                        {
                            <div class="linha">
                                <dt>Total do banco</dt>
                                <dd><Valor Centavos="resumo.InformadoCentavos" /></dd>
                            </div>
                        }
                        <div class="linha">
                            <dt>
                                Compras que somam
                                <span class="linha-sub">@Formato.Quantos(resumo.QuantidadeAcrescentada, "compra", "compras")</span>
                            </dt>
                            <dd><Valor Centavos="resumo.AcrescentadoCentavos" /></dd>
                        </div>
                        <div class="linha">
                            <dt>
                                Compras já no total
                                <span class="linha-sub">
                                    @Formato.Quantos(resumo.QuantidadeDetalhada, "compra", "compras")@(resumo.TotalFoiInformado ? ", não somam de novo" : ", somam porque não há total do banco")
                                </span>
                            </dt>
                            <dd><Valor Centavos="resumo.DetalhadoCentavos" /></dd>
                        </div>
                        <div class="linha total">
                            <dt>Total da fatura</dt>
                            <dd><Valor Centavos="resumo.TotalCentavos" /></dd>
                        </div>
                        @if (resumo.PagoCentavos > 0)
                        {
                            <div class="linha">
                                <dt>
                                    Pago
                                    @if (resumo.Fatura.PagoEm is DateOnly pagoEm)
                                    {
                                        <span class="linha-sub">último em @Formato.Data(pagoEm)</span>
                                    }
                                </dt>
                                <dd><Valor Centavos="-resumo.PagoCentavos" /></dd>
                            </div>
                        }
                        @if (resumo.JurosCentavos > 0)
                        {
                            <div class="linha">
                                <dt>
                                    Juros do atraso
                                    <span class="linha-sub">@Formato.Quantos(resumo.MesesDeAtraso, "mês", "meses")</span>
                                </dt>
                                <dd class="valor-negativo"><Valor Centavos="resumo.JurosCentavos" Mais="true" /></dd>
                            </div>
                        }
                        <div class="linha total">
                            <dt>Falta pagar</dt>
                            <dd class="@(resumo.ASairCentavos > 0 ? "valor-negativo" : "")"><Valor Centavos="resumo.ASairCentavos" /></dd>
                        </div>
                    </dl>

                    <p class="dica">
                        Fecha em @Formato.DataCurta(resumo.Fatura.Fechamento), vence em @Formato.Data(resumo.Fatura.Vencimento).
                        @if (resumo.ASairCentavos > 0)
                        {
                            <text>Sai da conta em @Formato.Data(MinhasFinancas.Domain.Calendario.Maior(resumo.Fatura.Vencimento, Relogio.Hoje)).</text>
                        }
                    </p>

                    @if (resumo.ASairCentavos > 0)
                    {
                        <div class="acoes">
                            <button type="button" class="btn secundario" @onclick="() => AbrirPagamento(resumo)">
                                Registrar pagamento
                            </button>
                        </div>
                    }
                </div>
            </ChildContent>
        </Grupo>
    }
}

@if (_editando is not null && _dados is not null)
{
    <Modal Titulo="@(_editando.Id == 0 ? "Nova fatura" : "Editar fatura")" AoFechar="FecharFatura">
        <ChildContent>
            <div class="campo-grupo">
                <Rotulo Texto="Cartão" Para="cartao-fatura" />
                <select id="cartao-fatura" class="campo" @bind="_cartaoId" @bind:after="SugerirDatas">
                    <option value="0">Escolha o cartão</option>
                    @foreach (var cartao in _dados.Cartoes)
                    {
                        <option value="@cartao.Id">@cartao.Nome</option>
                    }
                </select>
            </div>

            <div class="linha-campos">
                <div class="campo-grupo">
                    <Rotulo Texto="Fecha em" Para="fechamento-fatura" />
                    <CampoData Valor="_editando.Fechamento"
                               ValorChanged="v => _editando.Fechamento = v ?? Relogio.Hoje" Id="fechamento-fatura" />
                </div>
                <div class="campo-grupo">
                    <Rotulo Texto="Vence em" Para="vencimento-fatura" />
                    <CampoData Valor="_editando.Vencimento"
                               ValorChanged="v => _editando.Vencimento = v ?? Relogio.Hoje" Id="vencimento-fatura" />
                </div>
            </div>

            <div class="campo-grupo">
                <label class="interruptor">
                    Informar o total do banco
                    <input type="checkbox" role="switch" checked="@(_editando.TotalInformadoCentavos is not null)"
                           @onchange="TrocarTotalInformado" />
                </label>
                <div class="dica">
                    @(_editando.TotalInformadoCentavos is null
                        ? "Desligado, a fatura é a soma das compras do ciclo."
                        : "O total manda. Compras marcadas como já no total não somam de novo.")
                </div>
            </div>

            @if (_editando.TotalInformadoCentavos is long total)
            {
                <div class="campo-grupo">
                    <Rotulo Texto="Total da fatura" Para="total-fatura" />
                    <CampoDinheiro Valor="total" ValorChanged="v => _editando.TotalInformadoCentavos = v"
                                   Id="total-fatura" />
                </div>
            }

            @if (_erros.Count > 0)
            {
                <Aviso Tipo="ruim" Papel="alert">
                    @foreach (var erro in _erros)
                    {
                        <div>@erro</div>
                    }
                </Aviso>
            }
        </ChildContent>
        <Rodape>
            <button type="button" class="btn" @onclick="SalvarFatura" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
            @if (_editando.Id != 0)
            {
                <button type="button" class="btn @(_confirmandoExclusao ? "perigo-cheio" : "perigo")" @onclick="ExcluirFatura">
                    @(_confirmandoExclusao ? "Excluir de vez" : "Excluir")
                </button>
            }
        </Rodape>
    </Modal>
}

@if (_pagando is not null)
{
    <Modal Titulo="Registrar pagamento" AoFechar="() => _pagando = null">
        <ChildContent>
            <dl class="linhas">
                <div class="linha">
                    <dt>Fatura</dt>
                    <dd>@_pagando.NomeCartao, @Formato.DataCurta(_pagando.Fatura.Vencimento)</dd>
                </div>
                <div class="linha total">
                    <dt>Falta pagar</dt>
                    <dd><Valor Centavos="_pagando.ASairCentavos" /></dd>
                </div>
            </dl>

            <div class="linha-campos" style="margin-top:12px">
                <div class="campo-grupo">
                    <Rotulo Texto="Valor pago" Para="valor-pago"
                            Ajuda="Pode ser menos que o total. O que faltar continua como dívida, saindo no vencimento." />
                    <CampoDinheiro Valor="_valorPago" ValorChanged="v => _valorPago = v" Id="valor-pago" />
                </div>
                <div class="campo-grupo">
                    <Rotulo Texto="Pago em" Para="data-pago" />
                    <CampoData Valor="_dataPagamento" ValorChanged="v => _dataPagamento = v ?? Relogio.Hoje" Id="data-pago" />
                </div>
            </div>

            @if (_erros.Count > 0)
            {
                <Aviso Tipo="ruim" Papel="alert">
                    @foreach (var erro in _erros)
                    {
                        <div>@erro</div>
                    }
                </Aviso>
            }
        </ChildContent>
        <Rodape>
            <button type="button" class="btn" @onclick="ConfirmarPagamento" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Confirmar")
            </button>
        </Rodape>
    </Modal>
}

@code {
    /// Os dados já carregados pela tela que hospeda o bloco. Carregar de novo aqui daria duas
    /// projeções por visita e deixaria as duas listas desencontradas depois de salvar.
    [Parameter] public DadosPlanejamento? Dados { get; set; }

    /// Avisa a tela que algo mudou, para ela recarregar tudo de uma vez.
    [Parameter] public EventCallback Mudou { get; set; }

    private DadosPlanejamento? _dados;
    private List<ResumoFatura> _resumos = [];

    private FaturaCartao? _editando;
    private ResumoFatura? _pagando;
    private int _cartaoId;
    private long _valorPago;
    private DateOnly _dataPagamento;
    private List<string> _erros = [];
    private bool _salvando;
    private bool _confirmandoExclusao;

    protected override void OnParametersSet()
    {
        _dados = Dados;
        _resumos = _dados is null ? [] : Servico.ResumirFaturas(_dados, Relogio.Hoje);
    }

    private async Task CarregarAsync() => await Mudou.InvokeAsync();

    /// <summary>Abre o formulário. Público para o botão "Nova" do cabeçalho da tela.</summary>
    public void AbrirFatura(FaturaCartao? original)
    {
        _erros = [];
        _confirmandoExclusao = false;

        if (original is null)
        {
            _cartaoId = _dados!.Cartoes.Count == 1 ? _dados.Cartoes[0].Id : 0;
            _editando = new FaturaCartao { Fechamento = Relogio.Hoje, Vencimento = Relogio.Hoje };
            SugerirDatas();
            StateHasChanged();
            return;
        }

        _cartaoId = original.CartaoId;

        // Copia, para cancelar não deixar a lista com dados meio editados.
        _editando = new FaturaCartao
        {
            Id = original.Id,
            CartaoId = original.CartaoId,
            Fechamento = original.Fechamento,
            Vencimento = original.Vencimento,
            TotalInformadoCentavos = original.TotalInformadoCentavos,
            PagoCentavos = original.PagoCentavos,
            PagoEm = original.PagoEm,
            Obs = original.Obs
        };
    }

    private void FecharFatura()
    {
        _editando = null;
        _confirmandoExclusao = false;
    }

    /// <summary>
    /// Preenche fechamento e vencimento pelos dias do cartão, no ciclo que ainda não venceu.
    /// Continuam editáveis: fatura antiga ou com data trocada pelo banco é caso comum.
    /// </summary>
    private void SugerirDatas()
    {
        if (_editando is null || _editando.Id != 0 ||
            _dados!.Cartoes.FirstOrDefault(c => c.Id == _cartaoId) is not Cartao cartao)
        {
            return;
        }

        var vencimento = MinhasFinancas.Domain.Calendario.NoMes(Relogio.Hoje.Year, Relogio.Hoje.Month, cartao.DiaVencimento);

        if (vencimento < Relogio.Hoje)
        {
            var proximo = Relogio.Hoje.AddMonths(1);
            vencimento = MinhasFinancas.Domain.Calendario.NoMes(proximo.Year, proximo.Month, cartao.DiaVencimento);
        }

        _editando.Vencimento = vencimento;
        _editando.Fechamento = MinhasFinancas.Domain.Calendario.NoMes(vencimento.Year, vencimento.Month, cartao.DiaFechamento);
    }

    private void TrocarTotalInformado(ChangeEventArgs evento)
    {
        if (_editando is not null)
        {
            _editando.TotalInformadoCentavos = evento.Value is true ? 0 : null;
        }
    }

    private async Task SalvarFatura()
    {
        if (_editando is null)
        {
            return;
        }

        _erros = [];

        if (_cartaoId <= 0)
        {
            _erros.Add("Escolha o cartão.");
        }

        if (_editando.Vencimento == default)
        {
            _erros.Add("Informe o vencimento.");
        }

        if (_editando.TotalInformadoCentavos is long total && total < 0)
        {
            _erros.Add("O total da fatura não pode ser negativo.");
        }

        if (_erros.Count > 0)
        {
            return;
        }

        _editando.CartaoId = _cartaoId;
        _salvando = true;

        try
        {
            await Servico.SalvarFaturaAsync(_editando);
            _editando = null;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    /// <summary>Excluir pede um segundo toque: a fatura some da previsão e o pagamento junto.</summary>
    private async Task ExcluirFatura()
    {
        if (_editando is not { Id: > 0 } fatura)
        {
            return;
        }

        if (!_confirmandoExclusao)
        {
            _confirmandoExclusao = true;
            return;
        }

        await Servico.ExcluirFaturaAsync(fatura.Id);
        FecharFatura();
        await CarregarAsync();
    }

    private void AbrirPagamento(ResumoFatura resumo)
    {
        _erros = [];
        _pagando = resumo;
        _valorPago = resumo.ASairCentavos;
        _dataPagamento = Relogio.Hoje;
    }

    private async Task ConfirmarPagamento()
    {
        if (_pagando is null)
        {
            return;
        }

        // Zero nao muda nada alem da data do ultimo pagamento. Negativo continua aceito: e o
        // unico jeito de corrigir um pagamento registrado a mais.
        _erros = _valorPago != 0 ? [] : ["Informe quanto foi pago."];

        if (_erros.Count > 0)
        {
            return;
        }

        _salvando = true;

        try
        {
            await Servico.PagarFaturaAsync(_pagando.Fatura.Id, _valorPago, _dataPagamento);
            _pagando = null;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }
}
