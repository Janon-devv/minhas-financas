@* Campo de dinheiro em centavos. inputmode=decimal abre o teclado numerico com virgula no iPhone.
   Aceita o jeito brasileiro (1.234,56) e os atalhos que a pessoa digita (50, R$ 90, 1234.56). *@

<span class="campo-dinheiro">
    @if (Prefixo is not null)
    {
        <span class="campo-dinheiro-prefixo" id="@_idPrefixo">@Prefixo</span>
    }
    <input @key="_chave"
           type="text"
           inputmode="decimal"
           enterkeyhint="done"
           autocomplete="off"
           class="campo dinheiro-campo @(Prefixo is null ? "" : "com-prefixo") @(Sufixo is null ? "" : "com-sufixo")"
           placeholder="0,00"
           value="@_texto"
           id="@Id"
           aria-describedby="@(Prefixo is not null ? _idPrefixo : Sufixo is not null ? _idSufixo : null)"
           @onchange="Alterou" />
    @if (Sufixo is not null)
    {
        <span class="campo-dinheiro-sufixo" id="@_idSufixo">@Sufixo</span>
    }
</span>

@code {
    private string _texto = "";
    private int _chave;
    private long _ultimoValor = long.MinValue;

    // O prefixo e lido pelo leitor de tela via aria-describedby, entao precisa de id proprio.
    // Esconder com aria-hidden tiraria a unica pista de que o campo e em reais.
    private readonly string _idPrefixo = $"moeda-{Guid.NewGuid():N}";
    private readonly string _idSufixo = $"unidade-{Guid.NewGuid():N}";

    [Parameter]
    public long Valor { get; set; }

    [Parameter]
    public EventCallback<long> ValorChanged { get; set; }

    [Parameter]
    public string? Id { get; set; }

    /// <summary>R$ por padrao. Nulo para campos que nao sao dinheiro, como a taxa de juros.</summary>
    [Parameter]
    public string? Prefixo { get; set; } = "R$";

    /// <summary>Unidade depois do numero, como % na taxa de juros.</summary>
    [Parameter]
    public string? Sufixo { get; set; }

    protected override void OnParametersSet()
    {
        // So reescreve o texto quando o valor vem de fora, para nao atropelar a digitacao.
        if (Valor != _ultimoValor)
        {
            _ultimoValor = Valor;
            _texto = Formato.ParaCampo(Valor);
        }
    }

    private async Task Alterou(ChangeEventArgs evento)
    {
        var digitado = evento.Value?.ToString();
        var valor = Formato.TentarDinheiro(digitado, out var centavos) ? centavos : 0;

        _ultimoValor = valor;
        _texto = Formato.ParaCampo(valor);

        // Troca a chave para o campo receber o texto normalizado mesmo quando o Blazor
        // acharia que nada mudou (por exemplo: digitou "abc" e o normalizado continua "0,00").
        _chave++;

        await ValorChanged.InvokeAsync(valor);
    }
}
