@* Icones em SVG, todos do mesmo desenho: traco de 1,8, pontas redondas, grade de 24.
   Renderizam igual em qualquer aparelho, diferente de simbolos de fonte. Sao sempre
   decorativos (aria-hidden): quem precisa de nome e o botao ou o texto ao lado. *@

<svg class="icone-svg" width="@Tamanho" height="@Tamanho" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Nome)
    {
        case "hoje":
            <path d="M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5H15v-5.5H9v5.5H5.5A1.5 1.5 0 0 1 4 19z" />
            break;

        case "calendario":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
            <path d="M3.5 10h17M8 3v4M16 3v4" />
            <path d="M8 14h2M14 14h2M8 17h2" />
            break;

        case "lancar":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 8.5v7M8.5 12h7" />
            break;

        case "resumo":
            <path d="M6 19.5V12M12 19.5V5M18 19.5v-9" stroke-width="3" />
            break;

        case "ajustes":
            <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
            <circle cx="15" cy="7" r="2.2" />
            <circle cx="9" cy="17" r="2.2" />
            break;

        case "simulador":
            <rect x="5" y="3" width="14" height="18" rx="2.5" />
            <path d="M8.5 7h7M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01M8.5 15h.01M12 15h.01M15.5 15v2.5M8.5 17.5h.01M12 17.5h.01" />
            break;

        case "meta":
            <circle cx="12" cy="12" r="8.5" />
            <circle cx="12" cy="12" r="4.5" />
            <circle cx="12" cy="12" r="0.8" fill="currentColor" />
            break;

        case "mais":
            <path d="M12 5v14M5 12h14" />
            break;

        case "voltar":
            <path d="M15 19l-7-7 7-7" />
            break;

        case "avancar":
            <path d="M9 5l7 7-7 7" />
            break;

        case "seta":
            <path d="M9.5 6l6 6-6 6" />
            break;

        case "abrir":
            <path d="M6 9l6 6 6-6" />
            break;

        case "fechar":
            <path d="M6 6l12 12M18 6L6 18" />
            break;

        case "editar":
            <path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17v3z" />
            break;

        case "entrada":
            <path d="M17 7 7 17M7 9v8h8" />
            break;

        case "saida":
            <path d="M7 17 17 7M9 7h8v8" />
            break;

        case "cartao":
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="M2.5 10h19M6.5 15h3" />
            break;

        case "economia":
            <ellipse cx="12" cy="6.5" rx="7" ry="2.8" />
            <path d="M5 6.5v5c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-5M5 11.5v5c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-5" />
            break;

        case "diario":
            <path d="M5.5 8h13l-1.2 11.2a1.5 1.5 0 0 1-1.5 1.3H8.2a1.5 1.5 0 0 1-1.5-1.3z" />
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
            break;

        case "carteira":
            <path d="M18 7V5.5A1.5 1.5 0 0 0 16.5 4h-11A2.5 2.5 0 0 0 3 6.5v11A2.5 2.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V9a1 1 0 0 0-1-1H5.5A2.5 2.5 0 0 1 3 6.5" />
            <path d="M16 14h.01" stroke-width="2.6" />
            break;

        case "banco":
            <path d="M3.5 9.5 12 4l8.5 5.5M5.5 10v7.5M10 10v7.5M14 10v7.5M18.5 10v7.5M3.5 20.5h17" />
            break;

        case "fatura":
            <path d="M6 3.5h12v17l-2.5-1.6-2.5 1.6-2-1.4-2.5 1.4L6 18.8z" />
            <path d="M9 8.5h6M9 12h6M9 15.5h3" />
            break;

        case "renda":
            <path d="M3.5 16.5 9 11l4 4 7.5-7.5" />
            <path d="M15 7.5h5.5V13" />
            break;

        case "tag":
            <path d="M3.5 11.6V4.5a1 1 0 0 1 1-1h7.1a1 1 0 0 1 .7.3l8.2 8.2a1 1 0 0 1 0 1.4l-7.1 7.1a1 1 0 0 1-1.4 0l-8.2-8.2a1 1 0 0 1-.3-.7z" />
            <path d="M8 8h.01" stroke-width="2.6" />
            break;

        case "relogio":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;

        case "info":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 11v5.5M12 7.8h.01" />
            break;

        case "baixar":
            <path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" />
            break;

        case "enviar":
            <path d="M12 16V5M7 9.5l5-5 5 5M5 20h14" />
            break;

        case "lixeira":
            <path d="M4.5 7h15M10 11v6M14 11v6M9 7V4.5h6V7M6.5 7l1 12.5a1.5 1.5 0 0 0 1.5 1.5h6a1.5 1.5 0 0 0 1.5-1.5l1-12.5" />
            break;

        case "check":
            <path d="M5 12.5 10 17.5 19 7" />
            break;

        case "alerta":
            <path d="M10.3 4.2 2.8 17.5a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z" />
            <path d="M12 9.5v4.5M12 17h.01" />
            break;

        case "erro":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5v5.5M12 16.2h.01" />
            break;
    }
</svg>

@code {
    [Parameter]
    public string Nome { get; set; } = "hoje";

    [Parameter]
    public int Tamanho { get; set; } = 20;
}
