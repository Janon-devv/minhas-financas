@inject PlanejamentoService Servico
@inject IRelogio Relogio

@* Renda variavel (R17). Um campo por mes, no lugar de um lancamento novo a cada mes.
   E registro do que JA CAIU: conta nas entradas do mes, mas nao mexe no saldo previsto,
   porque o saldo conferido com o banco ja contem esse dinheiro. *@

<Grupo>
    <div class="corpo">
        <SeletorMes Mes="_mes" PodeAvancar="PodeAvancar" AoMover="Mover" Claro="true" />

        <div class="campo-grupo" style="margin-top:16px">
            <Rotulo Texto="@($"Recebido em {Formato.Mes(_mes.Month)}")" Para="ganho-variavel"
                    Ajuda="Renda que muda todo mês, como corrida por aplicativo ou freela. Informe o que já caiu na conta. O valor já está no saldo conferido com o banco, por isso não muda o saldo previsto: conta só nas entradas do mês, no Resumo. Mês sem registro conta zero; o app não estima média." />
            <CampoDinheiro Id="ganho-variavel" @bind-Valor="_valor" />
            <div class="dica">
                @(_registrado is null
                    ? "Sem registro, o mês conta zero. Não muda o saldo previsto."
                    : "Não muda o saldo previsto: o valor já está no saldo do banco.")
            </div>
        </div>

        <div class="campo-grupo">
            <Rotulo Texto="Origem (opcional)" Para="ganho-obs" />
            <input id="ganho-obs" class="campo" maxlength="60" autocomplete="off" @bind="_obs" placeholder="Uber, freela" />
        </div>

        <div class="acoes">
            <button type="button" class="btn" @onclick="Salvar" disabled="@_salvando">
                @(_salvando ? "Salvando..." : "Salvar")
            </button>
            @if (_registrado is not null)
            {
                <button type="button" class="btn contorno" @onclick="Limpar" disabled="@_salvando">
                    Apagar registro
                </button>
            }
        </div>

        @if (_confirmacao is not null)
        {
            <div style="margin-top:12px">
                <Aviso Tipo="bom" Papel="status">@_confirmacao</Aviso>
            </div>
        }
    </div>
</Grupo>

@if (_historico.Count > 0)
{
    <Grupo Titulo="Meses registrados">
        <Marcador>
            @if (GanhosVariaveis.Media(_historico) is long media)
            {
                <span class="pilula neutra">média @Formato.Moeda(media)</span>
            }
        </Marcador>
        <ChildContent>
            <ul class="lista">
                @foreach (var registro in _historico)
                {
                    var atual = registro.Ano == _mes.Year && registro.Mes == _mes.Month;

                    <li>
                        <button type="button" class="item" @onclick="() => Ir(registro)"
                                aria-current="@(atual ? "true" : null)"
                                style="@(atual ? "background:var(--acento-suave)" : null)">
                            <span class="icone-tipo entrada"><Icone Nome="renda" Tamanho="20" /></span>
                            <span class="item-principal">
                                <span class="item-titulo">@Formato.MesAno(registro.Ano, registro.Mes)</span>
                                @if (!string.IsNullOrWhiteSpace(registro.Obs))
                                {
                                    <span class="item-sub">@registro.Obs</span>
                                }
                            </span>
                            <span class="item-valor"><Valor Centavos="registro.ValorCentavos" /></span>
                        </button>
                    </li>
                }
            </ul>
        </ChildContent>
    </Grupo>
}

@code {
    /// Os dados ja carregados pela tela que hospeda o bloco.
    [Parameter] public DadosPlanejamento? Dados { get; set; }

    /// Avisa a tela que algo mudou, para ela recarregar tudo de uma vez.
    [Parameter] public EventCallback Mudou { get; set; }

    private DateOnly _mes;
    private long _valor;
    private string _obs = "";
    private bool _salvando;
    private string? _confirmacao;
    private GanhoVariavel? _registrado;
    private List<GanhoVariavel> _historico = [];

    // Nao da para preencher o mes que ainda nao comecou: o ganho so e conhecido depois que entra.
    private bool PodeAvancar => _mes < MinhasFinancas.Domain.Calendario.PrimeiroDiaDoMes(Relogio.Hoje);

    protected override void OnInitialized() =>
        _mes = MinhasFinancas.Domain.Calendario.PrimeiroDiaDoMes(Relogio.Hoje);

    protected override void OnParametersSet()
    {
        _historico = GanhosVariaveis.MaisRecentesPrimeiro(Dados?.GanhosVariaveis ?? []);
        Ler();
    }

    private void Ler()
    {
        _registrado = _historico.FirstOrDefault(g => g.Ano == _mes.Year && g.Mes == _mes.Month);
        _valor = _registrado?.ValorCentavos ?? 0;
        _obs = _registrado?.Obs ?? "";
    }

    private void Mover(int meses)
    {
        _mes = _mes.AddMonths(meses);
        _confirmacao = null;
        Ler();
    }

    private void Ir(GanhoVariavel registro)
    {
        _mes = new DateOnly(registro.Ano, registro.Mes, 1);
        _confirmacao = null;
        Ler();
    }

    private async Task Salvar()
    {
        _salvando = true;

        try
        {
            await Servico.SalvarGanhoVariavelAsync(_mes.Year, _mes.Month, _valor, _obs);
            _confirmacao = $"Salvo: {Formato.Moeda(_valor)} em {Formato.MesAno(_mes.Year, _mes.Month)}.";
            await Mudou.InvokeAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task Limpar()
    {
        _salvando = true;

        try
        {
            await Servico.LimparGanhoVariavelAsync(_mes.Year, _mes.Month);
            _confirmacao = $"{char.ToUpper(Formato.MesAno(_mes.Year, _mes.Month)[0])}{Formato.MesAno(_mes.Year, _mes.Month)[1..]} ficou sem registro.";
            await Mudou.InvokeAsync();
        }
        finally
        {
            _salvando = false;
        }
    }
}
