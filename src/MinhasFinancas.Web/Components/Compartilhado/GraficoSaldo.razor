@*
    Grafico de linha do saldo, em SVG puro: nenhuma biblioteca, nenhum JavaScript.
    preserveAspectRatio=none deixa a largura esticar; vector-effect mantem a espessura
    da linha constante, senao ela ficaria achatada junto com o desenho.
*@

@if (Serie.Count >= 2)
{
    @* O rotulo conta o que o grafico mostra, nao so o periodo: quem usa leitor de tela
       precisa do mesmo recado que quem olha a curva. *@
    <svg class="grafico" viewBox="0 0 @Largura @Altura" preserveAspectRatio="none" role="img"
         aria-label="@Resumo()">

        @if (SerieComparacao is not { Count: >= 2 })
        {
            <polygon class="area-saldo" points="@Area(Serie)" />
        }

        @if (_mostrarZero)
        {
            <line class="linha-zero" x1="0" y1="@Coordenada(0)" x2="@Largura" y2="@Coordenada(0)"
                  vector-effect="non-scaling-stroke" />
        }

        @if (_mostrarConforto)
        {
            <line class="linha-conforto" x1="0" y1="@Coordenada(Conforto)" x2="@Largura" y2="@Coordenada(Conforto)"
                  vector-effect="non-scaling-stroke" />
        }

        @if (SerieComparacao is { Count: >= 2 })
        {
            <polyline class="linha-simulada" points="@Pontos(SerieComparacao)" vector-effect="non-scaling-stroke" />
            @foreach (var marcador in Marcadores(SerieComparacao))
            {
                <circle class="ponto ponto-simulado" cx="@marcador.X" cy="@marcador.Y" r="6" aria-hidden="true">
                    <title>@marcador.Titulo</title>
                </circle>
            }
        }

        <polyline class="linha-saldo" points="@Pontos(Serie)" vector-effect="non-scaling-stroke" />
        @* Marcador por ponto: sem JS, so o <title> nativo do SVG. Mostra o valor exato ao passar
           o mouse, sem substituir o texto ao lado (quem usa toque nao tem hover). *@
        @foreach (var marcador in Marcadores(Serie))
        {
            <circle class="ponto" cx="@marcador.X" cy="@marcador.Y" r="6" aria-hidden="true">
                <title>@marcador.Titulo</title>
            </circle>
        }
    </svg>

    <div class="legenda">
        <span class="s-saldo">@(SerieComparacao is { Count: >= 2 } ? "sem a compra" : "saldo previsto")</span>
        @if (SerieComparacao is { Count: >= 2 })
        {
            <span class="s-compra">com a compra</span>
        }
        @if (_mostrarConforto)
        {
            <span class="s-conforto">conforto @Formato.Moeda(Conforto)</span>
        }
        <span class="faixa" style="margin-left:auto">de @Formato.Moeda(_minimoSerie) a @Formato.Moeda(_maximoSerie)</span>
    </div>
}
else
{
    <p class="vazio">Poucos dias para desenhar o gráfico.</p>
}

@code {
    private const int Largura = 600;
    private const int Altura = 168;
    private const int Margem = 10;

    private long _minimo;
    private long _maximo;
    private long _minimoSerie;
    private long _maximoSerie;
    private bool _mostrarZero;
    private bool _mostrarConforto;

    [Parameter]
    public IReadOnlyList<PontoGrafico> Serie { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PontoGrafico>? SerieComparacao { get; set; }

    [Parameter]
    public long Conforto { get; set; }

    protected override void OnParametersSet()
    {
        if (Serie.Count == 0)
        {
            return;
        }

        var valores = Serie.Select(p => p.Centavos).ToList();

        if (SerieComparacao is not null)
        {
            valores.AddRange(SerieComparacao.Select(p => p.Centavos));
        }

        // A faixa escrita na legenda e a dos saldos; a do desenho inclui zero e conforto,
        // para as duas linhas de referencia caberem.
        _minimoSerie = valores.Min();
        _maximoSerie = valores.Max();

        valores.Add(Conforto);
        valores.Add(0);

        _minimo = valores.Min();
        _maximo = valores.Max();

        if (_minimo == _maximo)
        {
            _minimo -= 100;
            _maximo += 100;
        }

        _mostrarZero = _minimo < 0;
        _mostrarConforto = Conforto > 0;
    }

    /// <summary>Descricao em texto do que a curva mostra, para leitor de tela.</summary>
    private string Resumo()
    {
        if (Serie.Count == 0)
        {
            return "Gráfico sem dados.";
        }

        var menor = Serie.MinBy(ponto => ponto.Centavos)!;

        var texto = $"Saldo previsto de {Formato.Data(Serie[0].Data)} a {Formato.Data(Serie[^1].Data)}. " +
                    $"Começa em {Formato.Moeda(Serie[0].Centavos)} e termina em {Formato.Moeda(Serie[^1].Centavos)}. " +
                    $"O menor saldo do período é {Formato.Moeda(menor.Centavos)}, em {Formato.Data(menor.Data)}.";

        if (Conforto > 0 && menor.Centavos < Conforto)
        {
            texto += $" Isso fica abaixo do saldo de conforto de {Formato.Moeda(Conforto)}.";
        }

        if (SerieComparacao is { Count: > 0 })
        {
            var menorCom = SerieComparacao.MinBy(ponto => ponto.Centavos)!;
            texto += $" Com a compra, o menor saldo passa a ser {Formato.Moeda(menorCom.Centavos)}, " +
                     $"em {Formato.Data(menorCom.Data)}.";
        }

        return texto;
    }

    private double Y(long centavos)
    {
        var faixa = (double)(_maximo - _minimo);
        var proporcao = (centavos - _minimo) / faixa;
        return Math.Round(Altura - Margem - (proporcao * (Altura - (2 * Margem))), 2);
    }

    /// <summary>
    /// Coordenada pronta para ir num atributo de SVG. Precisa de ponto decimal: a aplicacao roda
    /// em pt-BR, e se a virgula vazar para o atributo o navegador descarta o valor e desenha em zero.
    /// </summary>
    private string Coordenada(long centavos) =>
        Y(centavos).ToString(CultureInfo.InvariantCulture);

    private string Pontos(IReadOnlyList<PontoGrafico> serie)
    {
        if (serie.Count < 2)
        {
            return "";
        }

        var passo = (double)Largura / (serie.Count - 1);

        return string.Join(" ", serie.Select((ponto, i) =>
            string.Create(CultureInfo.InvariantCulture, $"{Math.Round(i * passo, 2)},{Y(ponto.Centavos)}")));
    }

    /// <summary>A curva fechada ate a base do desenho, para a area clara embaixo dela.</summary>
    private string Area(IReadOnlyList<PontoGrafico> serie) =>
        string.Create(CultureInfo.InvariantCulture, $"0,{Altura} {Pontos(serie)} {Largura},{Altura}");

    /// <summary>Um circulo por ponto, para o mouse achar o valor exato.</summary>
    private IEnumerable<(string X, string Y, string Titulo)> Marcadores(IReadOnlyList<PontoGrafico> serie)
    {
        if (serie.Count < 2)
        {
            yield break;
        }

        var passo = (double)Largura / (serie.Count - 1);

        for (var i = 0; i < serie.Count; i++)
        {
            var ponto = serie[i];
            var x = Math.Round(i * passo, 2).ToString(CultureInfo.InvariantCulture);
            var titulo = $"{Formato.Data(ponto.Data)}: {Formato.Moeda(ponto.Centavos)}";
            yield return (x, Coordenada(ponto.Centavos), titulo);
        }
    }
}
