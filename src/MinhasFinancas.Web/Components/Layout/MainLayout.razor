@inherits LayoutComponentBase

<div class="faixa-status" aria-hidden="true"></div>

<main class="conteudo">
    <div class="pagina">
        @* Erro inesperado numa tela fica nela: sem isto, qualquer excecao derrubava a conexao
           inteira e sobrava só a faixa "Algo deu errado" com recarregar. *@
        <ErrorBoundary @ref="_falha">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <Cabecalho Titulo="Algo deu errado" />
                <Vazio Texto="Não deu para concluir nesta tela. O que já estava salvo continua salvo." NomeIcone="erro">
                    <button type="button" class="btn" @onclick="TentarDeNovo">Tentar de novo</button>
                </Vazio>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</main>

@* No celular esta barra fica embaixo; no PC vira a coluna lateral, pelo CSS. *@
<nav class="nav" aria-label="Principal">
    <div class="nav-marca">
        <strong>Minhas Finanças</strong>
        <span>Raul Janon</span>
    </div>
    <NavLink href="" Match="NavLinkMatch.All">
        <span class="nav-icone"><Icone Nome="hoje" Tamanho="22" /></span>
        Hoje
    </NavLink>
    <NavLink href="calendario">
        <span class="nav-icone"><Icone Nome="calendario" Tamanho="22" /></span>
        Calendário
    </NavLink>
    <NavLink href="lancamentos">
        <span class="nav-icone"><Icone Nome="lancar" Tamanho="22" /></span>
        Lançar
    </NavLink>
    <NavLink href="resumo">
        <span class="nav-icone"><Icone Nome="resumo" Tamanho="22" /></span>
        Resumo
    </NavLink>
    @* No celular, metas e simulação ficam nas ações rápidas da tela Hoje. *@
    <NavLink href="metas" class="so-desktop">
        <span class="nav-icone"><Icone Nome="meta" Tamanho="22" /></span>
        Metas
    </NavLink>
    <NavLink href="simulador" class="so-desktop">
        <span class="nav-icone"><Icone Nome="simulador" Tamanho="22" /></span>
        Simular compra
    </NavLink>
    <NavLink href="ajustes">
        <span class="nav-icone"><Icone Nome="ajustes" Tamanho="22" /></span>
        Ajustes
    </NavLink>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">Fechar</span>
</div>

@code {
    private ErrorBoundary? _falha;

    // Trocar de tela limpa o erro da anterior: a falha de uma tela nao pode travar as outras.
    protected override void OnParametersSet() => _falha?.Recover();

    private void TentarDeNovo() => _falha?.Recover();
}
