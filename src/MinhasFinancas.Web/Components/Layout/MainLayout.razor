@inherits LayoutComponentBase

<div class="faixa-status" aria-hidden="true"></div>

<main class="conteudo com-lateral">
    <div class="pagina">
        @* Erro inesperado numa tela fica nela: sem isto, qualquer excecao derrubava a conexao
           inteira e sobrava só a faixa "Algo deu errado" com recarregar. *@
        <ErrorBoundary @ref="_falha">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <Cabecalho Titulo="Algo deu errado" />
                <Vazio Texto="Não deu para concluir nesta tela. O que já estava salvo continua salvo." NomeIcone="erro">
                    <button type="button" class="btn" @onclick="TentarDeNovo">Tentar de novo</button>
                </Vazio>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</main>

@*
    No celular esta barra fica embaixo; no PC vira a coluna lateral, pelo CSS. Secoes e o botao
    de recolher so existem no PC: no celular as secoes sao display: contents e os links ficam
    lado a lado na barra, na mesma ordem.
*@
<nav class="nav" aria-label="Principal">
    <div class="nav-marca">
        <img src="icone-180.png" alt="" width="40" height="40" />
        <div class="nav-texto">
            <strong>Minhas Finanças</strong>
            <span>Raul Janon</span>
        </div>
    </div>

    <div class="nav-secao">
        <span class="nav-secao-titulo so-desktop">Dia a dia</span>
        <NavLink href="" Match="NavLinkMatch.All">
            <span class="nav-icone"><Icone Nome="hoje" Tamanho="22" /></span>
            <span class="nav-texto">Hoje</span>
        </NavLink>
        <NavLink href="calendario">
            <span class="nav-icone"><Icone Nome="calendario" Tamanho="22" /></span>
            <span class="nav-texto">Calendário</span>
        </NavLink>
        <NavLink href="lancamentos">
            <span class="nav-icone"><Icone Nome="lancar" Tamanho="22" /></span>
            <span class="nav-texto">Lançar</span>
        </NavLink>
        <NavLink href="resumo">
            <span class="nav-icone"><Icone Nome="resumo" Tamanho="22" /></span>
            <span class="nav-texto">Resumo</span>
        </NavLink>
    </div>

    @* No celular, metas e simulação ficam nas ações rápidas da tela Hoje. *@
    <div class="nav-secao">
        <span class="nav-secao-titulo so-desktop">Planejar</span>
        <NavLink href="metas" class="so-desktop">
            <span class="nav-icone"><Icone Nome="meta" Tamanho="22" /></span>
            <span class="nav-texto">Metas</span>
        </NavLink>
        <NavLink href="simulador" class="so-desktop">
            <span class="nav-icone"><Icone Nome="simulador" Tamanho="22" /></span>
            <span class="nav-texto">Simular compra</span>
        </NavLink>
    </div>

    <div class="nav-secao nav-rodape">
        <NavLink href="ajustes">
            <span class="nav-icone"><Icone Nome="ajustes" Tamanho="22" /></span>
            <span class="nav-texto">Ajustes</span>
        </NavLink>
        @* Quem recolhe e o app.js, direto no navegador: sem ida e volta ao servidor. *@
        <button type="button" class="nav-recolher so-desktop" data-recolher>
            <span class="nav-icone"><Icone Nome="voltar" Tamanho="22" /></span>
            <span class="nav-texto">
                <span class="quando-aberta">Recolher menu</span>
                <span class="quando-recolhida">Expandir menu</span>
            </span>
        </button>
    </div>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">Fechar</span>
</div>

@code {
    private ErrorBoundary? _falha;

    // Trocar de tela limpa o erro da anterior: a falha de uma tela nao pode travar as outras.
    protected override void OnParametersSet() => _falha?.Recover();

    private void TentarDeNovo() => _falha?.Recover();
}
