@inherits LayoutComponentBase
@inject IRelogio Relogio

<header class="topo">
    <div class="marca">
        <span class="marca-nome">Minhas Finanças</span>
        <span class="assinatura so-desktop">Raul Janon</span>
    </div>
    <span class="data-hoje">@Formato.DiaSemana(Relogio.Hoje), @Formato.Data(Relogio.Hoje)</span>
</header>

<main class="conteudo">
    @Body
</main>

@* No celular esta barra fica embaixo; no PC vira a coluna lateral, pelo CSS. *@
<nav class="nav">
    <NavLink href="" Match="NavLinkMatch.All">
        <span class="icone"><Icone Nome="hoje" /></span>
        Hoje
    </NavLink>
    <NavLink href="calendario">
        <span class="icone"><Icone Nome="calendario" /></span>
        Calendário
    </NavLink>
    <NavLink href="plano">
        <span class="icone"><Icone Nome="plano" /></span>
        Plano
    </NavLink>
    <NavLink href="resumo">
        <span class="icone"><Icone Nome="resumo" /></span>
        Resumo
    </NavLink>
    <NavLink href="metas" class="so-desktop">
        <span class="icone"><Icone Nome="meta" /></span>
        Metas
    </NavLink>
    <NavLink href="simulador" class="so-desktop">
        <span class="icone"><Icone Nome="simulador" /></span>
        Simulador
    </NavLink>
    <NavLink href="ajustes">
        <span class="icone"><Icone Nome="ajustes" /></span>
        Ajustes
    </NavLink>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado por aqui.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">fechar</span>
</div>
