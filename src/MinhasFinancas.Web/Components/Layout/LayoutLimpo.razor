@* Layout sem a barra de navegacao, usado no primeiro acesso. *@
@inherits LayoutComponentBase

<header class="topo">
    <div class="marca">
        <span class="marca-nome">Minhas Finanças</span>
        <span class="assinatura so-desktop">Raul Janon</span>
    </div>
</header>

<main class="conteudo limpo" style="padding-bottom: calc(env(safe-area-inset-bottom) + 2rem);">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado por aqui.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">fechar</span>
</div>
