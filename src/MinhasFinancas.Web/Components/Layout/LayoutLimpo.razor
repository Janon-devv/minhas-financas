@* Layout sem a barra de navegacao, usado no primeiro acesso. *@
@inherits LayoutComponentBase

<div class="faixa-status" aria-hidden="true"></div>

<main class="conteudo limpo">
    <div class="pagina">
        @Body
    </div>
</main>

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">Fechar</span>
</div>
